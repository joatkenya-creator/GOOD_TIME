{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "incremental": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    /* Strictness — everything on. New code should never need a `any` escape hatch. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": false,
    /* No `baseUrl`: deprecated in TS 6 and gone in 7. Since TS 4.4 `paths` are
       resolved relative to this file, which is what the `./` prefix below means. */
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/types/**/*.d.ts",
    ".next/dev/types/**/*.ts"
  ],
  /* `cloudflare/` is checked by its own tsconfig, not this one.
     `@cloudflare/workers-types` replaces the DOM's `Response`, `fetch` and
     friends with the Workers runtime's stricter versions — `response.json()`
     returns `unknown` there rather than `any`. Correct inside the Worker,
     wrong for every React component in `src/`, so the two are kept apart.
     `npm run typecheck` runs both. */
  "exclude": ["node_modules", ".next", "src/generated", "cloudflare"]
}
