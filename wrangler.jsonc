/**
 * Cloudflare Workers deployment.
 *
 * `main` points at `cloudflare/worker.ts`, not at the OpenNext output, because
 * the application needs `queue` and `scheduled` handlers alongside `fetch` and
 * those are Worker-level exports. That file imports the OpenNext build and adds
 * them; see its header.
 *
 * ## Secrets are not here
 *
 * Nothing in `vars` is a secret. Everything sensitive — the database URL, the
 * Klarna credentials, `AUTH_SECRET`, the Upstash token — is set with
 * `wrangler secret put` or in the dashboard, per environment. `vars` is
 * committed to git; secrets are not, and a value in the wrong one is a leak
 * that survives in history. The full list is in docs/environment.md.
 *
 * ## Environments
 *
 * `staging` and `production` are separate Workers with separate bindings,
 * separate queues and separate databases. They are deliberately not the same
 * Worker with a flag: a staging deploy must be incapable of writing to the
 * production database or of charging a real customer.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intimate-bunnie",
  "main": "cloudflare/worker.ts",

  /**
   * Pin the runtime date. Workers gates behaviour changes behind this, so
   * leaving it floating means the runtime can change under a deploy that
   * changed nothing.
   */
  "compatibility_date": "2026-07-01",

  /**
   * `nodejs_compat` is required, not optional: Prisma, the Auth.js crypto
   * paths and OpenNext's own runtime all reach for `node:` builtins.
   * `global_fetch_strictly_public` makes a fetch to our own hostname go out to
   * the internet and back through Cloudflare rather than looping inside the
   * isolate — which is what makes a self-referential request see the WAF, the
   * cache rules and the real headers.
   */
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "workers_dev": false,
  "preview_urls": true,

  "observability": {
    "enabled": true,
    // Sampling is for saving money on logs nobody reads. At this traffic level
    // the whole point is that the one broken checkout is in there.
    "head_sampling_rate": 1,
  },

  /** Uploads source maps so a Sentry stack trace names our files, not `worker.js:1`. */
  "upload_source_maps": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    /**
     * Static assets are served without ever waking the Worker. That is the
     * single largest performance lever here: a `.woff2` or a hashed JS chunk
     * costs zero CPU-ms and is served from the edge cache.
     */
    "run_worker_first": false,
  },

  "vars": {
    "NODE_ENV": "production",
    "NEXT_TELEMETRY_DISABLED": "1",
  },

  /**
   * Cron Triggers. Each entry must have a matching branch in
   * `cloudflare/worker.ts`'s `scheduled` handler — one without a branch fires
   * into the `default` case and reports itself.
   */
  "triggers": {
    "crons": [
      // The sweep. Picks up anything the push path missed, fires due schedules,
      // and reclaims jobs from crashed isolates.
      "* * * * *",
      // Returns stock held by abandoned checkouts.
      "*/15 * * * *",
      // Extends Klarna authorisations approaching expiry.
      "0 6 * * *",
    ],
  },

  /**
   * Queues — DISABLED, because Cloudflare Queues requires the Workers Paid plan.
   *
   * Commented rather than deleted: this is the configuration to restore, in
   * both this block and the two environments below, the day the plan is
   * upgraded. Create the dead-letter queues first or the others are rejected.
   *
   * ## What running without them actually costs
   *
   * Latency, not work. `src/lib/jobs/cf-queue.ts` resolves the binding at call
   * time and returns `null` when it is absent; `publish()` then returns `false`
   * without throwing, and the every-minute cron trigger above drains the
   * `background_jobs` table instead. Postgres was always the ledger — the queue
   * only ever owned the "in the next second rather than the next minute" part.
   *
   * So: a password-reset email arrives within about a minute rather than
   * immediately, and a bulk import starts on the next sweep. `/api/health`
   * reports push delivery as unavailable, which is how you tell this state from
   * a broken one.
   *
   * `max_batch_timeout` is short because these carry job *ids*, not payloads —
   * waiting to fill a batch would add latency to a password reset for no
   * throughput gain worth having.
   *
   * `max_retries` is deliberately low. The database already owns retry with
   * exponential backoff; these retries only cover the case where the consumer
   * could not reach the database at all, and three attempts is enough to ride
   * out a blip without turning a real outage into a retry storm.
   */
  // "queues": {
  //   "producers": [
  //     { "queue": "intimate-bunnie-jobs", "binding": "JOB_QUEUE" },
  //     { "queue": "intimate-bunnie-email", "binding": "EMAIL_QUEUE" },
  //   ],
  //   "consumers": [
  //     {
  //       "queue": "intimate-bunnie-jobs",
  //       "max_batch_size": 10,
  //       "max_batch_timeout": 5,
  //       "max_retries": 3,
  //       "max_concurrency": 10,
  //       "dead_letter_queue": "intimate-bunnie-jobs-dlq",
  //     },
  //     {
  //       "queue": "intimate-bunnie-email",
  //       "max_batch_size": 20,
  //       "max_batch_timeout": 2,
  //       "max_retries": 3,
  //       "max_concurrency": 5,
  //       "dead_letter_queue": "intimate-bunnie-email-dlq",
  //     },
  //   ],
  // },

  /**
   * Incremental cache for Next's ISR and `unstable_cache`.
   *
   * R2 rather than KV: KV is eventually consistent with a global write
   * propagation delay measured in tens of seconds, which for a revalidated
   * product page means a price change that is live in one region and stale in
   * another. R2 is strongly consistent for reads-after-write. The KV namespace
   * below is the *tag* index, where eventual consistency is fine because a tag
   * lookup that briefly misses only causes an extra revalidation.
   */
  // R2 is not enabled on the account, so the incremental cache is on KV for
  // now — see the note in open-next.config.ts. To switch back: enable R2,
  // create `intimate-bunnie-cache`, restore the line below, and change the
  // import in open-next.config.ts.
  // "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "intimate-bunnie-cache" }],
  "kv_namespaces": [
    { "binding": "NEXT_TAG_CACHE_KV", "id": "0d873984a99e4fc88c1debb954325725" },
    { "binding": "NEXT_INC_CACHE_KV", "id": "e6d70cde54f74dbb83b0cda5af2a9965" },
  ],

  /**
   * Deduplicates concurrent revalidations of the same page.
   *
   * Without it, a hundred simultaneous requests for an expired product page
   * each trigger their own regeneration — a hundred identical database reads
   * for one result. This is the "cache stampede" that turns a popular page into
   * an outage the moment its cache expires.
   */
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_CACHE_DO_SHARDED_TAG", "class_name": "DOShardedTagCache" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],

  /**
   * ## Everything below is repeated per environment on purpose
   *
   * Wrangler does **not** inherit `vars`, `queues`, `r2_buckets`,
   * `kv_namespaces` or `durable_objects` from the top level into a named
   * environment. A binding declared only at the top level is simply absent from
   * `--env production`, and the failure is silent until runtime: the cache
   * writes nowhere, `env.JOB_QUEUE` is undefined, and every email job throws
   * inside a queue producer nobody is watching.
   *
   * `wrangler deploy --env production --dry-run` warns about each omission.
   * Run it after editing this block.
   */
  "env": {
    "staging": {
      "name": "intimate-bunnie-staging",
      "vars": {
        "NODE_ENV": "production",
        "NEXT_TELEMETRY_DISABLED": "1",
        "SENTRY_ENVIRONMENT": "staging",
        "KLARNA_ENVIRONMENT": "playground",
        "NEXT_PUBLIC_KLARNA_ENVIRONMENT": "playground",
      },
      "routes": [{ "pattern": "staging.intimatebunnie.com", "custom_domain": true }],
      // Disabled with the top-level block — restore both together.
      // "queues": {
      //   "producers": [
      //     { "queue": "intimate-bunnie-jobs-staging", "binding": "JOB_QUEUE" },
      //     { "queue": "intimate-bunnie-email-staging", "binding": "EMAIL_QUEUE" },
      //   ],
      //   "consumers": [
      //     {
      //       "queue": "intimate-bunnie-jobs-staging",
      //       "max_batch_size": 10,
      //       "max_batch_timeout": 5,
      //       "max_retries": 3,
      //       "dead_letter_queue": "intimate-bunnie-jobs-dlq",
      //     },
      //     {
      //       "queue": "intimate-bunnie-email-staging",
      //       "max_batch_size": 20,
      //       "max_batch_timeout": 2,
      //       "max_retries": 3,
      //       "dead_letter_queue": "intimate-bunnie-email-dlq",
      //     },
      //   ],
      // },
      // Disabled with the top-level R2 binding.
      // "r2_buckets": [
      //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "intimate-bunnie-cache-staging" },
      // ],
      "kv_namespaces": [
        { "binding": "NEXT_TAG_CACHE_KV", "id": "23b64617299144049bdacd1284abcadf" },
        { "binding": "NEXT_INC_CACHE_KV", "id": "e48093418b694af5aa7fb6fff5d7dd51" },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
          { "name": "NEXT_CACHE_DO_SHARDED_TAG", "class_name": "DOShardedTagCache" },
        ],
      },
    },

    "production": {
      "name": "intimate-bunnie-production",
      "vars": {
        "NODE_ENV": "production",
        "NEXT_TELEMETRY_DISABLED": "1",
        "SENTRY_ENVIRONMENT": "production",
        "KLARNA_ENVIRONMENT": "production",
        "NEXT_PUBLIC_KLARNA_ENVIRONMENT": "production",
      },
      /**
       * Both the apex and `www`. The redirect between them is a Cloudflare
       * Bulk Redirect, not application code — see docs/cloudflare.md — because
       * a redirect served from the edge never wakes the Worker.
       */
      "routes": [
        { "pattern": "intimatebunnie.com", "custom_domain": true },
        { "pattern": "www.intimatebunnie.com", "custom_domain": true },
      ],
      // Disabled with the top-level block — restore all three together.
      // "queues": {
      //   "producers": [
      //     { "queue": "intimate-bunnie-jobs", "binding": "JOB_QUEUE" },
      //     { "queue": "intimate-bunnie-email", "binding": "EMAIL_QUEUE" },
      //   ],
      //   "consumers": [
      //     {
      //       "queue": "intimate-bunnie-jobs",
      //       "max_batch_size": 10,
      //       "max_batch_timeout": 5,
      //       "max_retries": 3,
      //       "max_concurrency": 10,
      //       "dead_letter_queue": "intimate-bunnie-jobs-dlq",
      //     },
      //     {
      //       "queue": "intimate-bunnie-email",
      //       "max_batch_size": 20,
      //       "max_batch_timeout": 2,
      //       "max_retries": 3,
      //       "max_concurrency": 5,
      //       "dead_letter_queue": "intimate-bunnie-email-dlq",
      //     },
      //   ],
      // },
      // Disabled with the top-level R2 binding.
      // "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "intimate-bunnie-cache" }],
      "kv_namespaces": [
        { "binding": "NEXT_TAG_CACHE_KV", "id": "0d873984a99e4fc88c1debb954325725" },
        { "binding": "NEXT_INC_CACHE_KV", "id": "e6d70cde54f74dbb83b0cda5af2a9965" },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
          { "name": "NEXT_CACHE_DO_SHARDED_TAG", "class_name": "DOShardedTagCache" },
        ],
      },
    },
  },
}
