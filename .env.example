# =============================================================================
# INTIMATE BUNNIE — environment template
#
# Copy to `.env` and fill in. Never commit `.env`.
#
# Only DATABASE_URL and AUTH_SECRET are needed to run `npm run dev`. Everything
# else degrades gracefully — the cache falls back to memory, emails log instead
# of sending, payments refuse with a clear message. That is deliberate, so a
# fresh clone works; `npm run verify:production` is the gate that stops a
# half-configured deploy reaching customers.
#
# In production nothing here lives in a file. Secrets are set with
# `wrangler secret put` per environment; non-secret values live in
# `wrangler.jsonc`'s `vars`. See docs/environment.md for the full table,
# including which variables are secret and how each one is rotated.
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (required) -----------------------------------------------------
# Pooled connection, used by the app at runtime. On Neon this is the `-pooler`
# host: Workers open a connection per isolate, and without the pooler a few
# hundred concurrent isolates exhaust Postgres' connection limit outright.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/good_time

# Unpooled connection, used by `prisma migrate`. Required in production.
# Neon's pooler is PgBouncer in transaction mode, where the session-level
# advisory lock Prisma takes does not survive between statements — so a
# migration through the pooler can run twice concurrently and deadlock.
DIRECT_DATABASE_URL=

# --- Auth.js (required) ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional OAuth provider (leave blank to hide the button).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Klarna (payments) -------------------------------------------------------
# From the Klarna Merchant Portal → Settings → Klarna API credentials.
# The username looks like `PK12345_1a2b3c4d`, not an email address.
# Playground and production are separate accounts with separate credentials —
# a playground credential against the production host authenticates and then
# 404s, which is a confusing way to lose an order.
KLARNA_USERNAME=
KLARNA_PASSWORD=

# Which regional API host to use. Getting this wrong 404s every request.
#   na = North America, eu = Europe, oc = Oceania
KLARNA_REGION=na
KLARNA_ENVIRONMENT=playground
NEXT_PUBLIC_KLARNA_ENVIRONMENT=playground

# Klarna does not sign its push notifications, so this secret goes in the
# notification URL path and is the only thing keeping the endpoint from being
# an open trigger. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KLARNA_WEBHOOK_SECRET=

# --- Tax ---------------------------------------------------------------------
# "table" charges the seeded state-average estimate. "taxjar" charges an
# assessed amount and is required before taking real orders — see docs/checkout.md.
TAX_PROVIDER=table
TAXJAR_API_KEY=

# Where orders ship from. Required by any tax provider: US sourcing rules mean
# the origin decides the rate in roughly eleven origin-sourced states.
SHIP_FROM_COUNTRY=US
SHIP_FROM_STATE=
SHIP_FROM_CITY=
SHIP_FROM_STREET=
SHIP_FROM_ZIP=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
# The production sender. The domain must be verified in Resend with SPF, DKIM
# and DMARC records published, or everything lands in spam. See docs/email.md.
EMAIL_FROM="INTIMATE BUNNIE <customercare@intimatebunnie.com>"
# Where customer replies go. Forwarded to a real mailbox by Cloudflare Email
# Routing — see docs/email.md.
EMAIL_REPLY_TO=customercare@intimatebunnie.com
# Verifies inbound bounce and complaint webhooks (Svix-signed).
RESEND_WEBHOOK_SECRET=

# --- Cache and rate limiting (Upstash Redis) ---------------------------------
# REST endpoint, not a redis:// URL. The Workers runtime has no raw TCP, so a
# redis:// client cannot connect from the edge at all.
#
# Unset means the cache falls back to process memory and rate limits become
# per-isolate — which on Workers means the effective limit is limit × isolates,
# i.e. no limit. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media (Cloudinary) ------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Monitoring (Sentry) -----------------------------------------------------
# Server DSN. Unset disables reporting entirely rather than buffering.
SENTRY_DSN=
# Browser DSN — public by design, and a separate project key so a flood of
# client-side noise cannot drown the server events.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# The git SHA in CI. Makes "when did this start" answerable.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Bot protection (Cloudflare Turnstile) -----------------------------------
# Applied to registration, password reset, newsletter and guest order lookup.
# Deliberately not to checkout: a customer with a full basket who gets a
# challenge is a lost sale, and Klarna already scores that request far more
# thoroughly than a bot check would.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Analytics ---------------------------------------------------------------
# GA4, GTM, Google Ads, Meta, TikTok, Pinterest, Clarity and Cloudflare Web
# Analytics are configured in the admin (Marketing → Integrations), not here.
# Their ids are public, they change without a deploy, and they are gated on
# consent at render time. See src/services/marketing/integrations.ts.
#
# Verification token from Google Search Console (HTML tag method).
GOOGLE_SITE_VERIFICATION=

# --- Operations --------------------------------------------------------------
# Shared secret for /api/cron/*. Unset means those endpoints refuse every
# request — a scheduled job anyone can trigger is a denial of service with
# extra steps. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# Set to `true` to skip env validation. CI type-checks and image builds only —
# never at runtime, where it would let a misconfigured deploy boot silently.
SKIP_ENV_VALIDATION=false
