# =============================================================================
# GOOD TIME — environment template
# Copy to `.env` and fill in. Never commit `.env`.
# Every variable is documented in docs/environment.md.
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (required) -----------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/good_time
# Unpooled connection used by `prisma migrate`. Omit if DATABASE_URL is direct.
DIRECT_DATABASE_URL=

# --- Auth.js (required) ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional OAuth provider (leave blank to hide the button).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (optional in phase 1) --------------------------------------------
# --- Tax ---------------------------------------------------------------------
# "table" charges the seeded state-average estimate. "taxjar" charges an assessed
# amount and is required before taking real orders — see docs/checkout.md.
TAX_PROVIDER=table
TAXJAR_API_KEY=
# Where orders ship from. Required by any tax provider.
SHIP_FROM_COUNTRY=US
SHIP_FROM_STATE=
SHIP_FROM_CITY=
SHIP_FROM_STREET=
SHIP_FROM_ZIP=

# Shared secret for the scheduled jobs at /api/cron/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Publishable key — safe in the browser, and required for the checkout card form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (optional in phase 1) --------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="GOOD TIME <no-reply@example.com>"

# --- Cloudinary (optional in phase 1) ----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Verification token from Google Search Console (HTML tag method).
GOOGLE_SITE_VERIFICATION=

# --- Operations --------------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# Set to `true` to skip env validation (CI type-checks, image builds only).
SKIP_ENV_VALIDATION=false
