# =============================================================================
# GOOD TIME — environment template
# Copy to `.env` and fill in. Never commit `.env`.
# Every variable is documented in docs/environment.md.
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (required) -----------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/good_time
# Unpooled connection used by `prisma migrate`. Omit if DATABASE_URL is direct.
DIRECT_DATABASE_URL=

# --- Auth.js (required) ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional OAuth provider (leave blank to hide the button).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (optional in phase 1) --------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (optional in phase 1) --------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="GOOD TIME <no-reply@example.com>"

# --- Cloudinary (optional in phase 1) ----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Verification token from Google Search Console (HTML tag method).
GOOGLE_SITE_VERIFICATION=

# --- Operations --------------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# Set to `true` to skip env validation (CI type-checks, image builds only).
SKIP_ENV_VALIDATION=false
