// GOOD TIME — commerce schema
//
// Conventions used throughout this file:
//   * Money is stored as integer minor units (US cents). Never floats.
//   * Every externally addressable record has a `slug` for SEO-friendly URLs.
//   * Catalogue tables are soft-deleted (`deletedAt`) so orders keep referential history.
//   * Order lines snapshot product data — catalogue edits must never rewrite history.
//   * Indexes are declared for the read paths we know we need at 100k+ SKUs; see
//     docs/architecture.md for the query patterns each one serves.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryPolicy {
  DENY // refuse to sell past zero
  CONTINUE // allow backorder
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum OrderStatus {
  /// Created, payment not yet confirmed. Stock is reserved, not decremented.
  PENDING
  /// Payment captured. The only status that may decrement inventory.
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

/// Every meaningful thing that happens to an order, for the timeline and audit.
enum OrderEventType {
  CREATED
  PAYMENT_STARTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  STATUS_CHANGED
  FULFILLMENT_UPDATED
  NOTE_ADDED
  REFUND_ISSUED
  EMAIL_SENT
  CANCELLED
}

/// How a shipping rate computes its price.
enum ShippingRateType {
  FLAT
  FREE
  /// Base plus a per-kilogram increment.
  WEIGHT_BASED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

enum ShippingCarrier {
  USPS
  UPS
  FEDEX
  DHL
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum ImportSourceType {
  CSV
  XML
  JSON
  SUPPLIER_API
  AFFILIATE_FEED
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// How two products relate. One table, one enum — not four near-identical tables.
enum ProductRelationType {
  RELATED
  FREQUENTLY_BOUGHT_TOGETHER
  UPSELL
  CROSS_SELL
}

/// Datatype of an attribute value, which decides how it is rendered and filtered.
enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  /// One of a fixed set — the only type that becomes a filter facet.
  ENUM
}

// ---------------------------------------------------------------------------
// Identity, access control and Auth.js adapter tables
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String? // null for OAuth-only accounts
  firstName     String?
  lastName      String?
  phone         String?
  image         String?
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  acceptsMarketing Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts          Account[]
  sessions          Session[]
  roles             UserRole[]
  addresses         Address[]
  orders            Order[]
  carts             Cart[]
  reviews           Review[]
  reviewVotes       ReviewVote[]
  wishlists         Wishlist[]
  recentlyViewed    RecentlyViewed[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  passwordResets    PasswordResetToken[]
  couponRedemptions CouponRedemption[]
  /// Coupons issued to this customer specifically — win-back, service recovery.
  personalCoupons   Coupon[]
  rolesAssigned     UserRole[]           @relation("RoleAssignedBy")

  // --- Customer account (phase 5) ---
  preferences             UserPreferences?
  notificationPreferences NotificationPreference[]
  paymentMethods          SavedPaymentMethod[]
  userSessions            UserSession[]
  loginEvents             LoginEvent[]
  rewardAccount           RewardAccount?
  referralCode            ReferralCode?
  returnRequests          ReturnRequest[]

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("users")
}

/// Named capability, e.g. `product:write`. Seeded, not user-editable at runtime.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  roles Role[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // CUSTOMER, ADMIN, SUPER_ADMIN
  name        String
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  users       UserRole[]

  @@map("roles")
}

/// Explicit join so role grants are auditable (who granted, when).
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("RoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Used by Auth.js for email verification and magic links.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // only the hash is stored; the raw token is emailed once
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String // US state / territory code
  postalCode String
  country    String      @default("US")
  phone      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders  Order[] @relation("OrderShippingAddress")
  billingOrders   Order[] @relation("OrderBillingAddress")

  @@index([userId, type])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Content, media and SEO
// ---------------------------------------------------------------------------

/// Cloudinary-backed asset. `publicId` is the Cloudinary handle, not a URL, so the
/// delivery transform can change without a data migration.
model Media {
  id        String    @id @default(cuid())
  type      MediaType @default(IMAGE)
  publicId  String    @unique
  url       String
  alt       String?
  width     Int?
  height    Int?
  bytes     Int?
  format    String?
  folder    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  productMedia ProductMedia[]
  categories   Category[]
  brands       Brand[]
  collections  Collection[]
  posts        Post[]

  @@index([folder, createdAt])
  @@map("media")
}

/// Shared SEO overrides. Absent row means "derive metadata from the record itself".
model SeoMetadata {
  id             String   @id @default(cuid())
  title          String?
  description    String?
  keywords       String[] @default([])
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImageUrl     String?
  twitterCard    String?  @default("summary_large_image")
  noindex        Boolean  @default(false)
  nofollow       Boolean  @default(false)
  structuredData Json? // JSON-LD overrides merged over the generated graph

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product?
  category   Category?
  collection Collection?
  brand      Brand?
  post       Post?
  page       Page?

  @@map("seo_metadata")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  parentId    String?
  slug        String  @unique
  name        String
  description String?
  imageId     String?
  /// Materialised ancestor path (`/wellness/massage`) — one indexed lookup instead of
  /// a recursive CTE when rendering breadcrumbs or a whole subtree.
  path        String
  depth       Int     @default(0)
  position    Int     @default(0)
  isActive    Boolean @default(true)
  seoId       String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Hero copy for the category landing page. Longer than `description`, which is
  /// reused as the meta description.
  heroHeadline String?
  heroBody     String?   @db.Text

  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryTree")
  image           Media?            @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo             SeoMetadata?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products        ProductCategory[]
  primaryProducts Product[]         @relation("PrimaryCategory")

  @@index([parentId, position])
  @@index([path])
  @@index([isActive, deletedAt])
  @@map("categories")
}

model Brand {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  logoId      String?
  websiteUrl  String?
  isActive    Boolean @default(true)
  seoId       String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  logo     Media?       @relation(fields: [logoId], references: [id], onDelete: SetNull)
  seo      SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([isActive, name])
  @@map("brands")
}

/// Merchandising grouping that cuts across the category tree ("New In", "Gift Guide").
model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  imageId     String?
  isActive    Boolean   @default(true)
  position    Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  /// Non-null means the collection is rule-driven rather than hand-picked.
  rules       Json?
  seoId       String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image    Media?              @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo      SeoMetadata?        @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products ProductCollection[]

  @@index([isActive, position])
  @@map("collections")
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  subtitle         String?
  /// One or two sentences for cards and meta descriptions.
  shortDescription String?
  description      String?       @db.Text
  status           ProductStatus @default(DRAFT)
  brandId          String?
  seoId            String?       @unique

  /// Product-level identifiers. Per-variant SKUs live on `Variant`; this is the
  /// parent/style code a supplier or accountant refers to.
  sku     String? @unique
  barcode String?

  /// Denormalised price range in *effective* cents (sale price where one is set),
  /// maintained from the variant set. Sorting and filtering 100k products by price
  /// must never require a join or an aggregate.
  minPriceCents Int    @default(0)
  maxPriceCents Int    @default(0)
  currency      String @default("USD")

  /// Denormalised review rollup — same reasoning as the price range.
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  /// Denormalised merchandising counters. `soldCount` drives the best-seller sort
  /// without aggregating over order items on every request.
  viewCount Int @default(0)
  soldCount Int @default(0)

  isFeatured  Boolean @default(false)
  isNewArrival Boolean @default(false)
  /// True when any variant has an active sale price. Maintained with the price range.
  isOnSale    Boolean @default(false)
  isAdultOnly Boolean @default(true) // regulated category: age-gated by default

  /// Bullet list for the product page. Prose lives in `description`.
  features String[] @default([])
  /// Free-form spec sheet for values that are displayed but never filtered on.
  attributes Json?

  /**
   * Flattened facet tokens — `["color:rose", "material:silicone", "tag:waterproof"]`.
   *
   * This is the one denormalisation that makes multi-facet filtering viable at
   * scale. Filtering by colour through `VariantSelection -> Variant -> Product`
   * needs three joins per facet; a single GIN-indexed array answers any
   * combination with one index scan. Rebuilt from the source relations by
   * `rebuildProductFacets`.
   */
  facets String[] @default([])

  /// Canonical category, used to build the product's one true URL. Denormalised so
  /// generating a link never needs to sort the category join table.
  primaryCategoryId String?

  /// Per-product overrides. Null falls back to the store-wide policy in `Setting`.
  shippingNote     String?
  returnPolicyNote String?

  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  brand           Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  seo             SeoMetadata?         @relation(fields: [seoId], references: [id], onDelete: SetNull)
  primaryCategory Category?            @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  categories      ProductCategory[]
  collections     ProductCollection[]
  media           ProductMedia[]
  options         VariantOption[]
  variants        Variant[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  tags            Tag[]
  productAttributes ProductAttribute[]
  relationsFrom   ProductRelation[]    @relation("RelationSource")
  relationsTo     ProductRelation[]    @relation("RelationTarget")
  recentlyViewed  RecentlyViewed[]
  searchDocument  ProductSearchDocument?

  // Storefront listing: "active, not deleted, newest first".
  @@index([status, deletedAt, publishedAt])
  // Price and rating facets on a filtered listing.
  @@index([status, minPriceCents])
  @@index([status, ratingAverage])
  @@index([status, soldCount])
  @@index([brandId, status])
  @@index([isFeatured, status])
  @@index([isOnSale, status])
  @@index([isNewArrival, status])
  @@index([primaryCategoryId])
  // Multi-facet filtering. GIN is what makes `facets hasSome [...]` an index scan.
  @@index([facets], type: Gin)
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
  @@map("product_collections")
}

model ProductMedia {
  productId String
  mediaId   String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, position])
  @@map("product_media")
}

/// An axis of variation for one product ("Colour", "Size").
model VariantOption {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  VariantOptionValue[]

  @@unique([productId, name])
  @@map("variant_options")
}

model VariantOptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String
  position Int    @default(0)

  option    VariantOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  selections VariantSelection[]

  @@unique([optionId, value])
  @@map("variant_option_values")
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  barcode   String?
  name      String // "Rose / Large"

  /**
   * Three price fields, because a storefront needs to answer three questions:
   *
   *   `priceCents`          the everyday list price
   *   `salePriceCents`      an active promotional price, or null
   *   `compareAtPriceCents` MSRP / anchor for a "compare at" strike-through
   *
   * The *effective* price is `salePriceCents ?? priceCents`. Never re-derive that
   * inline — use `effectivePriceCents()` so the rule stays in one place.
   */
  priceCents          Int
  salePriceCents      Int?
  compareAtPriceCents Int?
  costCents           Int?

  /// Physical dimensions in whole millimetres and grams: integers, never floats.
  weightGrams         Int?
  lengthMm            Int?
  widthMm             Int?
  heightMm            Int?
  /// Category-specific and genuinely load-bearing for this shop's buyers.
  insertableLengthMm  Int?
  diameterMm          Int?

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  selections    VariantSelection[]
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([productId, position])
  @@index([isActive, priceCents])
  @@index([isActive, salePriceCents])
  @@map("variants")
}

/// Resolves a variant to exactly one value per option axis.
model VariantSelection {
  variantId String
  valueId   String

  variant Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   VariantOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@index([valueId])
  @@map("variant_selections")
}

model Inventory {
  id        String @id @default(cuid())
  variantId String @unique

  /// Physically on hand. `available` = quantity - reserved.
  quantity  Int             @default(0)
  /// Held by in-flight checkouts; released on order completion or reservation expiry.
  reserved  Int             @default(0)
  lowStockThreshold Int     @default(5)
  policy    InventoryPolicy @default(DENY)
  location  String          @default("default")

  updatedAt DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([quantity])
  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id     String  @id @default(cuid())
  userId String?
  /// Opaque cookie value for guest carts; merged into the user cart on sign-in.
  sessionToken String? @unique
  currency  String    @default("USD")
  couponId  String?
  expiresAt DateTime?

  /// Captured at checkout for a guest, so an order can be traced without an account.
  email String?
  /// Free-text gift message, carried through to the order and the packing slip.
  giftNote String?

  /// Chosen shipping rate, held on the cart so totals survive a page reload.
  shippingRateId String?
  /// Destination used for the tax and shipping estimate before an address exists.
  estimateState      String?
  estimatePostalCode String?

  /// Whether to spend loyalty on this basket. Intent only — the amounts are
  /// recomputed at checkout from the live balance, never trusted from here.
  applyStoreCredit Boolean @default(false)
  redeemPoints     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingRate ShippingRate? @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)
  items        CartItem[]

  @@index([userId, updatedAt])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)
  /// Price captured when added, so cart totals stay stable during a price change.
  unitPriceCents Int

  /**
   * Moved out of the active cart but kept for later.
   *
   * A flag rather than a second table: it is the same row with the same variant
   * and quantity, and "save for later" then "move back" is a boolean flip rather
   * than a delete-and-recreate that loses the original price capture.
   */
  savedForLater Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders, payment and fulfilment
// ---------------------------------------------------------------------------

model Order {
  id          String @id @default(cuid())
  /// Human-facing reference (GT-100042). Never expose `id` in emails or receipts.
  orderNumber String @unique
  userId      String?
  email       String // kept separately: guest checkout, and users can change their email

  status      OrderStatus       @default(PENDING)
  paymentStatus PaymentStatus   @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  currency          String @default("USD")
  subtotalCents     Int
  discountCents     Int    @default(0)
  shippingCents     Int    @default(0)
  taxCents          Int    @default(0)
  totalCents        Int

  couponId          String?
  /// Code as entered, snapshotted — the coupon row may be edited or deleted later.
  couponCode        String?
  shippingAddressId String?
  billingAddressId  String?

  /**
   * The destination, snapshotted at checkout.
   *
   * The `Address` rows above only exist for signed-in customers who chose to save
   * one — a guest has no account to hang an address off, so without this the
   * order records where to ship nothing at all, and it cannot be fulfilled.
   *
   * Snapshotted rather than joined even when a row does exist: editing your
   * address book must not silently rewrite where a past order went.
   *
   * Shape: `{ firstName, lastName, company, line1, line2, city, state, postalCode, country, phone }`.
   */
  shippingAddressSnapshot Json?
  billingAddressSnapshot  Json?

  /// Chosen shipping method, snapshotted by name so a rate change cannot rewrite history.
  shippingMethod      String?
  shippingRateId      String?
  estimatedDeliveryAt DateTime?

  /**
   * Per-jurisdiction tax breakdown: `[{ label, jurisdiction, ratePercent, amountCents }]`.
   *
   * US sales tax is state plus county plus city, and a customer disputing a
   * charge — or an auditor — needs the split, not just the total. Snapshotted
   * because rates change and a past order must still explain itself.
   */
  taxBreakdown Json?

  /**
   * Loyalty tender applied to this order.
   *
   * Deliberately *not* folded into `discountCents`. Store credit and points are
   * tender, not a discount: a discount reduces what is owed and therefore the
   * taxable base, while credit pays part of a bill that was already taxed in
   * full. Treating them the same under-collects tax.
   *
   * So `totalCents` stays the full amount owed and keeps satisfying
   * `orders_total_is_sum`; the card is charged `totalCents - creditAppliedCents`.
   */
  creditAppliedCents Int @default(0)
  pointsRedeemed     Int @default(0)

  /**
   * Which implementation produced `taxCents`: "provider", "table" or "none".
   *
   * Quoting fails open — if the tax provider is unreachable the seeded estimate
   * stands in so the store keeps taking orders. That trade is only defensible if
   * the affected orders can be found again, which is what this column is for.
   * Suffixed "-degraded" when a provider was configured but fell back.
   */
  taxSource String?

  customerNote String?
  giftNote     String?
  internalNote String?
  /// Provenance for fraud review and attribution.
  ipAddress    String?
  userAgent    String?

  placedAt    DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddress Address?    @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?    @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingRate    ShippingRate? @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]
  returnRequests  ReturnRequest[]
  redemptions     CouponRedemption[]
  events          OrderEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([email])
  @@map("orders")
}

/**
 * Append-only order timeline.
 *
 * Every status change, payment attempt, email and note lands here and nothing is
 * ever updated or deleted. It powers the customer-facing timeline, answers "what
 * happened to order 100042" during a support call, and is the only record that
 * survives a bad admin edit.
 */
model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  type      OrderEventType
  /// Human-readable summary, safe to show a customer.
  message   String
  /// Machine-readable detail: previous/next status, provider ids, error codes.
  data      Json?
  /// Null for anything the system did on its own.
  actorId   String?
  /// False for internal notes, so one query drives the customer timeline.
  isCustomerVisible Boolean  @default(true)
  createdAt DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@map("order_events")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?

  /// Snapshot — the catalogue may be edited or deleted after the order is placed.
  productName String
  variantName String
  sku         String
  imageUrl    String?

  quantity        Int
  unitPriceCents  Int
  discountCents   Int @default(0)
  taxCents        Int @default(0)
  totalCents      Int

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     Variant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// One row per gateway attempt. Multiple providers and split payments are supported
/// by design — the order's `paymentStatus` is the rollup.
model Payment {
  id          String          @id @default(cuid())
  orderId     String
  provider    PaymentProvider @default(STRIPE)
  status      PaymentStatus   @default(PENDING)
  amountCents Int
  currency    String          @default("USD")
  /// Provider-side identifier (Stripe PaymentIntent id, PayPal capture id, ...).
  providerRef String?
  /// Idempotency guard for webhook replays.
  idempotencyKey String?      @unique
  errorCode   String?
  errorMessage String?
  metadata    Json?

  capturedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([orderId, status])
  @@map("payments")
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  carrier        ShippingCarrier @default(USPS)
  service        String? // "Priority Mail", "Ground Advantage"
  status         ShipmentStatus  @default(PENDING)
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  costCents      Int?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

/**
 * A purchasable shipping option.
 *
 * Rates are data, not code, so operations can add "Free over $75" or change a
 * price without a deploy. `type` decides how `priceCents` is derived; carrier
 * integrations replace this table's *pricing* later without changing how the
 * cart or checkout consume it.
 */
model ShippingRate {
  id          String           @id @default(cuid())
  code        String           @unique // "standard", "express"
  name        String // shown at checkout
  description String?
  type        ShippingRateType @default(FLAT)

  baseCents Int @default(0)
  /// WEIGHT_BASED only: added per kilogram above `freeWeightGrams`.
  perKgCents      Int @default(0)
  freeWeightGrams Int @default(0)

  /// Order subtotal at or above which this rate costs nothing. Null disables it.
  freeAboveSubtotalCents Int?
  /// Rate is offered only when the subtotal reaches this. Null means always.
  minSubtotalCents       Int?

  /// Empty means everywhere we ship. Populated restricts to these US states.
  states    String[] @default([])
  countries String[] @default(["US"])

  estimatedDaysMin Int     @default(3)
  estimatedDaysMax Int     @default(5)
  carrier          ShippingCarrier @default(USPS)

  isActive Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts  Cart[]
  orders Order[]

  @@index([isActive, position])
  @@map("shipping_rates")
}

/**
 * US sales tax rates, most specific match wins.
 *
 * Deliberately a lookup table rather than a provider integration: at one
 * jurisdiction it is a row, and the service layer that reads it
 * (`tax.service.ts`) is the seam an Avalara or TaxJar adapter slots into later.
 *
 * Rates are stored as basis points, not floats — 8.25% is `825`, so no rounding
 * error can creep into a tax figure that has to reconcile with a filing.
 */
model TaxRate {
  id String @id @default(cuid())

  country String @default("US")
  /// Two-letter state code. Null matches any state in the country.
  state   String?
  /// More specific than state. Null matches any county.
  county  String?
  /// Most specific of all. Null matches any postal code.
  postalCode String?

  label       String // "California state tax"
  /// Basis points: 825 = 8.25%.
  rateBasisPoints Int
  /// Some states tax shipping, some do not.
  appliesToShipping Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resolution order is postal -> county -> state, so this index serves all three.
  @@index([country, state, county, postalCode])
  @@index([isActive])
  @@map("tax_rates")
}

/**
 * Marketing consent, keyed by email rather than by user.
 *
 * A guest who ticks "email me offers" at checkout has no `User` row to hold
 * `acceptsMarketing`, and consent is exactly the thing that must be recorded with
 * its own timestamp and source — "when and how did they agree" is the first
 * question asked in any CAN-SPAM or GDPR complaint.
 */
model NewsletterSubscriber {
  id     String @id @default(cuid())
  email  String @unique
  /// Where the opt-in happened: "checkout", "footer", "popup".
  source String @default("unknown")

  /// Null while unconfirmed, set on double opt-in.
  confirmedAt   DateTime?
  unsubscribedAt DateTime?
  /// Single-use token for the confirm and unsubscribe links in every email.
  token         String    @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unsubscribedAt])
  @@map("newsletter_subscribers")
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  description  String?
  type         DiscountType @default(PERCENTAGE)
  /// Percentage points for PERCENTAGE, cents for FIXED_AMOUNT, ignored for FREE_SHIPPING.
  value        Int
  minSubtotalCents Int?
  maxDiscountCents Int?
  usageLimit       Int? // null = unlimited
  usageLimitPerUser Int?
  usedCount        Int      @default(0)
  isActive         Boolean  @default(true)
  startsAt         DateTime?
  endsAt           DateTime?

  /**
   * Customer-specific coupon.
   *
   * Non-null restricts redemption to one account — win-back offers, service
   * recovery, influencer codes. Enforced server-side in `coupon.service.ts`, not
   * by obscurity: a code that only works for one person must still reject
   * everyone else who guesses it.
   */
  userId String?
  /// Restricts to customers who have never ordered before.
  firstOrderOnly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  carts       Cart[]
  orders      Order[]
  redemptions CouponRedemption[]

  @@index([isActive, endsAt])
  @@index([userId])
  @@map("coupons")
}

/// Enforces per-user usage limits and gives finance a redemption ledger.
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  userId        String?
  orderId       String
  discountCents Int
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// Social proof and saved items
// ---------------------------------------------------------------------------

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String?
  authorName String
  rating    Int // 1..5, enforced by a check constraint in the migration
  title     String?
  body      String       @db.Text
  status    ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean @default(false)
  helpfulCount Int        @default(0)
  moderatedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  images  ReviewImage[]
  votes   ReviewVote[]

  // One review per customer per product.
  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  // "Most helpful" and "highest rated" sorts on a product's review list.
  @@index([productId, status, helpfulCount])
  @@index([productId, status, rating])
  @@index([status, createdAt])
  @@map("reviews")
}

/// Customer-submitted photos. Moderated with the parent review, never separately.
model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  publicId  String?
  alt       String?
  width     Int?
  height    Int?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, position])
  @@map("review_images")
}

/**
 * "Was this helpful?" votes.
 *
 * A row per voter rather than a bare counter, because an incrementable integer can
 * be clicked a thousand times by one person. `Review.helpfulCount` is the
 * denormalised rollup for sorting; this table is the truth.
 */
model ReviewVote {
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
  @@map("review_votes")
}

model Wishlist {
  id       String  @id @default(cuid())
  userId   String
  name     String  @default("My Wishlist")
  /// Share token for a public wishlist URL; null while private.
  shareToken String? @unique
  isDefault Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id         String  @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@index([productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Editorial
// ---------------------------------------------------------------------------

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String?
  content     String     @db.Text
  status      PostStatus @default(DRAFT)
  coverImageId String?
  authorName  String
  readingMinutes Int     @default(1)
  seoId       String?    @unique
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  coverImage Media?       @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  seo        SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)
  tags       Tag[]

  @@index([status, publishedAt])
  @@map("posts")
}

/// Shared vocabulary for both editorial posts and products, so "waterproof" means
/// the same thing in a guide and on a listing filter.
model Tag {
  id   String  @id @default(cuid())
  slug String  @unique
  name String
  /// Surfaced as a filter chip on the listing page when true.
  isFilterable Boolean @default(false)

  posts    Post[]
  products Product[]

  @@index([isFilterable])
  @@map("tags")
}

/// CMS-managed static content (privacy policy, shipping info, ...).
model Page {
  id        String     @id @default(cuid())
  slug      String     @unique
  title     String
  content   String     @db.Text
  status    PostStatus @default(DRAFT)
  seoId     String?    @unique
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seo SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("pages")
}

// ---------------------------------------------------------------------------
// Platform: settings, notifications, audit, import
// ---------------------------------------------------------------------------

/// Runtime configuration that must be editable without a deploy. Anything that is a
/// secret or a build-time concern belongs in the environment, not here.
model Setting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

model Notification {
  id      String              @id @default(cuid())
  userId  String
  channel NotificationChannel @default(IN_APP)
  type    String // "order.shipped", "review.approved", ...
  title   String
  body    String
  data    Json?
  readAt  DateTime?
  sentAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String // "Product", "Order", ...
  entityId   String
  /// Field-level before/after diff. Never store secrets or full card data here.
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalogue: attributes, relations, discovery
// ---------------------------------------------------------------------------

/**
 * Attribute vocabulary.
 *
 * Defined as data rather than as columns, so merchandising can add "Battery life"
 * without a migration. `isFilterable` decides whether values become facet tokens
 * on `Product.facets`; everything else is display-only.
 */
model AttributeDefinition {
  id           String        @id @default(cuid())
  key          String        @unique // "material", "waterproof", "noise-level"
  label        String // "Material"
  type         AttributeType @default(TEXT)
  unit         String? // "dB", "mm", "hours"
  /// Fixed option list for ENUM attributes.
  options      String[]      @default([])
  isFilterable Boolean       @default(false)
  /// Shown in the product page specification table.
  isSpec       Boolean       @default(true)
  position     Int           @default(0)
  group        String        @default("general") // spec-table section heading

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ProductAttribute[]

  @@index([isFilterable])
  @@index([group, position])
  @@map("attribute_definitions")
}

model ProductAttribute {
  productId    String
  definitionId String
  /// Stored as text and cast on read; `AttributeDefinition.type` says how.
  value        String

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@id([productId, definitionId])
  // Serves "every product whose material is silicone" before facets are rebuilt.
  @@index([definitionId, value])
  @@map("product_attributes")
}

/**
 * Product-to-product links: related items, frequently-bought-together, upsells.
 *
 * Directional and explicitly positioned, because merchandising order is a
 * commercial decision. `position` is honoured on read; ties fall back to the
 * target's sales rank.
 */
model ProductRelation {
  id        String              @id @default(cuid())
  productId String
  relatedId String
  type      ProductRelationType @default(RELATED)
  position  Int                 @default(0)
  /// Set by a recommender rather than a human. Null means hand-curated.
  score     Float?
  createdAt DateTime            @default(now())

  product Product @relation("RelationSource", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, type])
  @@index([productId, type, position])
  @@map("product_relations")
}

/**
 * Recently viewed, for signed-in customers.
 *
 * Guests are tracked in `localStorage` — see `useRecentlyViewed`. Persisting here
 * as well is what makes the list survive a device change, and later feeds
 * recommendations. Capped per user by `trimRecentlyViewed`.
 */
model RecentlyViewed {
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

/**
 * Search index.
 *
 * A denormalised text document per product, so full-text search never joins across
 * brand, category and variant tables. The actual index is a Postgres GIN index over
 * `to_tsvector('english', content)` plus a `pg_trgm` index for fuzzy matching —
 * both added by raw SQL in the migration, because Prisma cannot express a
 * functional index. Look in the `phase3_catalog` migration SQL.
 *
 * The title is repeated into `content` when the document is built, which gives
 * title matches a higher natural rank without needing `setweight` at query time.
 */
model ProductSearchDocument {
  productId    String   @id
  title        String
  brandName    String?
  categoryPath String?
  keywords     String[] @default([])
  /// Everything searchable, concatenated. Rebuilt by `rebuildSearchDocument`.
  content      String   @db.Text
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_search_documents")
}

/**
 * Search telemetry: powers "popular" and "trending" suggestions, and shows which
 * queries return nothing so the catalogue team can fix the gap.
 */
model SearchQuery {
  id          String   @id @default(cuid())
  /// Normalised (trimmed, lower-cased) so counts aggregate correctly.
  term        String
  resultCount Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())

  @@index([term, createdAt])
  // "Trending in the last 24 hours".
  @@index([createdAt])
  // "Queries that returned nothing", for merchandising.
  @@index([resultCount, createdAt])
  @@map("search_queries")
}

/// Bookkeeping for the future catalogue import pipeline. The adapters themselves are
/// deliberately not implemented yet — see src/features/import/.
model ImportJob {
  id         String           @id @default(cuid())
  sourceType ImportSourceType
  sourceName String
  status     ImportJobStatus  @default(QUEUED)
  /// Adapter-specific configuration (URL, credentials reference, field mapping).
  config     Json?
  totalRows     Int @default(0)
  processedRows Int @default(0)
  failedRows    Int @default(0)
  errors     Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, createdAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Customer account — phase 5
// ---------------------------------------------------------------------------

/// What a customer can be notified about. Channels are columns; topics are rows.
enum NotificationTopic {
  ORDER_UPDATES
  SHIPPING_UPDATES
  RETURNS
  PROMOTIONS
  NEWSLETTER
  PRODUCT_BACK_IN_STOCK
  REVIEW_REMINDERS
  SECURITY_ALERTS
}

enum ReturnStatus {
  /// Customer submitted it; nobody has looked yet.
  REQUESTED
  APPROVED
  REJECTED
  /// Label issued, parcel not yet scanned.
  IN_TRANSIT
  RECEIVED
  /// Inspected and refunded.
  REFUNDED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  NOT_AS_DESCRIBED
  WRONG_ITEM
  ARRIVED_LATE
  CHANGED_MIND
  QUALITY
  OTHER
}

/// Every movement in a reward balance. Points and credit share one ledger.
enum RewardTransactionType {
  EARNED_PURCHASE
  EARNED_REVIEW
  EARNED_REFERRAL
  EARNED_BIRTHDAY
  REDEEMED
  ADJUSTMENT
  EXPIRED
  /// Money, not points — a gift card or service-recovery credit.
  STORE_CREDIT
}

enum VipTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum LoginOutcome {
  SUCCESS
  BAD_PASSWORD
  UNKNOWN_EMAIL
  LOCKED
  /// Reached the second factor but failed it.
  FAILED_2FA
}

/**
 * Per-customer settings that are not identity.
 *
 * One row, created lazily on first save. Separate from `User` because these are
 * read on a handful of pages while `User` is read on nearly every request — and
 * because "who you are" and "how you like things" have different write patterns.
 */
model UserPreferences {
  userId String @id

  /// IANA zone, e.g. "America/New_York". Dates render in the customer's own time.
  timezone String @default("America/New_York")
  /// BCP-47 tag. Only "en-US" is served today; the column is what makes adding a
  /// second locale a data change rather than a schema change.
  locale   String @default("en-US")
  currency String @default("USD")

  /// Drives the "finish setting up your account" nudge on the dashboard.
  onboardingCompletedAt DateTime?
  /// For birthday rewards. Day and month only — the year is not collected.
  birthMonth Int?
  birthDay   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/**
 * One row per customer per topic.
 *
 * Rows rather than a column per topic-and-channel: adding a topic becomes an
 * insert instead of a migration, and a missing row means "the default for that
 * topic" rather than "off" — which matters, because order updates must never
 * silently stop because a row was never written.
 */
model NotificationPreference {
  userId String
  topic  NotificationTopic

  email Boolean @default(true)
  /// Both are architecture. No SMS or push provider is wired up yet.
  sms   Boolean @default(false)
  push  Boolean @default(false)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic])
  @@map("notification_preferences")
}

/**
 * A card on file, by reference only.
 *
 * **No card data is stored here and none may ever be.** `providerRef` is a Stripe
 * PaymentMethod id; `brand`, `last4` and the expiry are the display fragments
 * Stripe itself returns, enough to render "Visa ending 4242". Storing a card
 * number — even encrypted — moves this store out of PCI SAQ-A into a scope that
 * needs an annual audit. That is a business decision, not an engineering one.
 */
model SavedPaymentMethod {
  id     String @id @default(cuid())
  userId String

  provider    PaymentProvider @default(STRIPE)
  /// Stripe Customer id. Needed to list or detach the method later.
  customerRef String
  /// Stripe PaymentMethod id — the only handle we hold on the card.
  providerRef String          @unique

  brand     String?
  last4     String?
  expMonth  Int?
  expYear   Int?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("saved_payment_methods")
}

/**
 * A signed-in device.
 *
 * Sessions live in a JWT, so this table does not authenticate anyone — it exists
 * so a customer can *see* where they are signed in and revoke it. The JWT carries
 * this row's id, and `revokedAt` is checked on every authenticated request — a
 * primary-key lookup — so revoking a device takes effect on its very next request.
 */
model UserSession {
  id     String @id @default(cuid())
  userId String

  userAgent String?
  ipAddress String?
  /// Coarse location for the "signed in from" line. City-level at most.
  location  String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastSeenAt])
  @@map("user_sessions")
}

/**
 * Sign-in attempts, successful or not.
 *
 * Shown to the customer as recent activity, and kept as the evidence trail for an
 * account-takeover investigation. Failures are recorded too: three bad passwords
 * from a country the customer has never visited is the signal, and it only exists
 * if the failures were written down.
 */
model LoginEvent {
  id     String @id @default(cuid())
  /// Null when the email matched no account — there is nobody to attribute it to.
  userId String?
  /// Recorded even when `userId` is null, so attempts against a non-existent
  /// account are still countable.
  email  String

  outcome   LoginOutcome
  /// "credentials", "google", ...
  method    String       @default("credentials")
  ipAddress String?
  userAgent String?
  location  String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_events")
}

/**
 * A customer's loyalty balances.
 *
 * The balances are cached aggregates; `RewardTransaction` is the truth. Storing
 * the running total avoids summing a lifetime of rows to render a badge, and any
 * disagreement between the two is a bug that the ledger wins.
 *
 * **No business rules are implemented.** Nothing earns, expires or redeems yet —
 * this is the shape those rules will eventually write into.
 */
model RewardAccount {
  userId String @id

  pointsBalance    Int     @default(0)
  /// Money, in cents, like every other amount in this system.
  storeCreditCents Int     @default(0)
  tier             VipTier @default(STANDARD)
  tierReviewedAt   DateTime?

  /// Last birthday grant, so the annual reward pays once a year and not once a visit.
  lastBirthdayGrantAt DateTime?
  /// The code this customer signed up with, and when their referrer was paid.
  referredByCode      String?
  referralPaidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions RewardTransaction[]

  @@map("reward_accounts")
}

model RewardTransaction {
  id     String @id @default(cuid())
  userId String

  type RewardTransactionType
  /// Signed. Negative is a redemption or an expiry.
  points      Int @default(0)
  amountCents Int @default(0)

  /// Customer-facing: "Order GT-100042", "Referred a friend".
  description String
  orderId     String?
  /// Null means it never expires.
  expiresAt   DateTime?

  createdAt DateTime @default(now())

  account RewardAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reward_transactions")
}

/**
 * A customer's referral code.
 *
 * One per customer, created on demand. `uses` is denormalised for display; the
 * authoritative count is the reward transactions attributed to it.
 */
model ReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  code   String @unique

  uses        Int  @default(0)
  /// What the referred friend gets. Null until the programme is configured.
  rewardCents Int?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

/**
 * A request to send something back.
 *
 * Its own aggregate rather than a flag on `Order`, because a return has its own
 * lifecycle, its own timeline and its own subset of line items — an order can be
 * partly returned twice, for different reasons, weeks apart.
 *
 * The approval workflow is architecture: the statuses and their transitions exist,
 * and the admin UI that drives them arrives in a later phase.
 */
model ReturnRequest {
  id           String @id @default(cuid())
  /// Human-facing, like an order number: "RMA-100042".
  returnNumber String @unique
  orderId      String
  userId       String?

  status ReturnStatus @default(REQUESTED)
  reason ReturnReason
  /// The customer's own words, shown to whoever reviews it.
  comment String?

  /// Filled in once inspected. Not necessarily the sum of the items' prices — a
  /// restocking fee or a partial refund is a judgement call.
  refundCents Int?
  refundedAt  DateTime?

  /// Return shipping, once a label exists.
  carrier        ShippingCarrier?
  trackingNumber String?
  trackingUrl    String?

  /// Set when a reviewer acts. Null while REQUESTED.
  reviewedAt   DateTime?
  reviewerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items ReturnItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String

  quantity Int
  reason   ReturnReason
  /// Recorded on inspection: "unopened", "opened", "damaged".
  condition String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@map("return_items")
}
