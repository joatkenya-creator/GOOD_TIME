// INTIMATE BUNNIE — commerce schema
//
// Conventions used throughout this file:
//   * Money is stored as integer minor units (US cents). Never floats.
//   * Every externally addressable record has a `slug` for SEO-friendly URLs.
//   * Catalogue tables are soft-deleted (`deletedAt`) so orders keep referential history.
//   * Order lines snapshot product data — catalogue edits must never rewrite history.
//   * Indexes are declared for the read paths we know we need at 100k+ SKUs; see
//     docs/architecture.md for the query patterns each one serves.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // `relationJoins` lets a query with includes be one LATERAL JOIN instead of
  // one statement per relation. On the product page that is eleven round trips
  // collapsing into one — see scripts/measure-product-page.ts for the numbers.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryPolicy {
  DENY // refuse to sell past zero
  CONTINUE // allow backorder
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum OrderStatus {
  /// Created, payment not yet confirmed. Stock is reserved, not decremented.
  PENDING
  /// Payment captured. The only status that may decrement inventory.
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

/// Every meaningful thing that happens to an order, for the timeline and audit.
enum OrderEventType {
  CREATED
  PAYMENT_STARTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  STATUS_CHANGED
  FULFILLMENT_UPDATED
  NOTE_ADDED
  REFUND_ISSUED
  EMAIL_SENT
  CANCELLED
}

/// How a shipping rate computes its price.
enum ShippingRateType {
  FLAT
  FREE
  /// Base plus a per-kilogram increment.
  WEIGHT_BASED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentProvider {
  /// The live provider. Authorise at checkout, capture at fulfilment.
  KLARNA
  /// Retained so historical rows keep their meaning. Nothing writes it.
  STRIPE
  PAYPAL
  MANUAL
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

enum ShippingCarrier {
  USPS
  UPS
  FEDEX
  DHL
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum ImportSourceType {
  CSV
  EXCEL
  XML
  JSON
  /// A Google Merchant-format feed a partner publishes for us. Same XML shape
  /// as RSS 2.0 with the `g:` namespace, which most affiliate networks emit.
  GOOGLE_MERCHANT
  SUPPLIER_API
  AFFILIATE_FEED
  PARTNER_CATALOG
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  /// Some rows landed, some did not. Distinguished from FAILED because the
  /// operator's next move is different: review the failures, not re-run the lot.
  PARTIAL
  FAILED
  CANCELLED
  ROLLED_BACK
}

/// How two products relate. One table, one enum — not four near-identical tables.
enum ProductRelationType {
  RELATED
  FREQUENTLY_BOUGHT_TOGETHER
  UPSELL
  CROSS_SELL
}

/// Datatype of an attribute value, which decides how it is rendered and filtered.
enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  /// One of a fixed set — the only type that becomes a filter facet.
  ENUM
}

// ---------------------------------------------------------------------------
// Identity, access control and Auth.js adapter tables
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  emailVerified    DateTime?
  passwordHash     String? // null for OAuth-only accounts
  firstName        String?
  lastName         String?
  phone            String?
  image            String?
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?
  acceptsMarketing Boolean    @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts          Account[]
  sessions          Session[]
  roles             UserRole[]
  addresses         Address[]
  orders            Order[]
  carts             Cart[]
  reviews           Review[]
  reviewVotes       ReviewVote[]
  wishlists         Wishlist[]
  recentlyViewed    RecentlyViewed[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  passwordResets    PasswordResetToken[]
  couponRedemptions CouponRedemption[]
  /// Coupons issued to this customer specifically — win-back, service recovery.
  personalCoupons   Coupon[]
  rolesAssigned     UserRole[]           @relation("RoleAssignedBy")

  // --- Customer account (phase 5) ---
  preferences             UserPreferences?
  notificationPreferences NotificationPreference[]
  paymentMethods          SavedPaymentMethod[]
  userSessions            UserSession[]
  loginEvents             LoginEvent[]
  rewardAccount           RewardAccount?
  referralCode            ReferralCode?
  returnRequests          ReturnRequest[]

  // --- Phase 6: administration ------------------------------------------
  stockAdjustments  StockAdjustment[]      @relation("StockAdjustedBy")
  redirectsCreated  Redirect[]             @relation("RedirectCreatedBy")
  staffNotesAbout   StaffNote[]            @relation("StaffNoteSubject")
  staffNotesWritten StaffNote[]            @relation("StaffNoteAuthor")
  giftCardsIssued   GiftCard[]             @relation("GiftCardIssuedBy")
  giftCardAdjusted  GiftCardTransaction[]  @relation("GiftCardAdjustedBy")
  importTemplates   ImportTemplate[]       @relation("ImportTemplateAuthor")
  marketingEdits    MarketingIntegration[] @relation("MarketingIntegrationEditor")
  analyticsEvents   AnalyticsEvent[]
  adminAlertsRead   AdminAlert[]           @relation("AdminAlertReadBy")
  /// Staff-applied labels for segmentation. Never visible to the customer.
  adminTags         String[]               @default([])

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("users")
}

/// Named capability, e.g. `product:write`. Seeded, not user-editable at runtime.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  roles Role[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // CUSTOMER, ADMIN, SUPER_ADMIN
  name        String
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  users       UserRole[]

  @@map("roles")
}

/// Explicit join so role grants are auditable (who granted, when).
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("RoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Used by Auth.js for email verification and magic links.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // only the hash is stored; the raw token is emailed once
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String // US state / territory code
  postalCode String
  country    String      @default("US")
  phone      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("OrderShippingAddress")
  billingOrders  Order[] @relation("OrderBillingAddress")

  @@index([userId, type])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Content, media and SEO
// ---------------------------------------------------------------------------

/// Cloudinary-backed asset. `publicId` is the Cloudinary handle, not a URL, so the
/// delivery transform can change without a data migration.
model Media {
  id       String    @id @default(cuid())
  type     MediaType @default(IMAGE)
  publicId String    @unique
  url      String
  alt      String?
  width    Int?
  height   Int?
  bytes    Int?
  format   String?
  folder   String?

  /// SHA-256 of the uploaded bytes.
  ///
  /// The same product photo arrives from three suppliers as `IMG_4821.jpg`,
  /// `main.jpg` and `SKU-1234-1.jpg`. Comparing filenames catches none of
  /// them; comparing content catches all three before anything reaches the CDN.
  checksum String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productMedia ProductMedia[]
  categories   Category[]
  brands       Brand[]
  collections  Collection[]
  posts        Post[]

  contentBlocks    ContentBlock[]         @relation("ContentBlockImage")
  optimizationLogs MediaOptimizationLog[]

  @@index([folder, createdAt])
  @@index([checksum])
  @@map("media")
}

/// Shared SEO overrides. Absent row means "derive metadata from the record itself".
model SeoMetadata {
  id             String   @id @default(cuid())
  title          String?
  description    String?
  keywords       String[] @default([])
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImageUrl     String?
  twitterCard    String?  @default("summary_large_image")
  noindex        Boolean  @default(false)
  nofollow       Boolean  @default(false)
  structuredData Json? // JSON-LD overrides merged over the generated graph

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product?
  category   Category?
  collection Collection?
  brand      Brand?
  post       Post?
  page       Page?

  @@map("seo_metadata")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  parentId    String?
  slug        String  @unique
  name        String
  description String?
  imageId     String?
  /// Materialised ancestor path (`/wellness/massage`) — one indexed lookup instead of
  /// a recursive CTE when rendering breadcrumbs or a whole subtree.
  path        String
  depth       Int     @default(0)
  position    Int     @default(0)
  isActive    Boolean @default(true)
  seoId       String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Hero copy for the category landing page. Longer than `description`, which is
  /// reused as the meta description.
  heroHeadline String?
  heroBody     String? @db.Text

  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryTree")
  image           Media?            @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo             SeoMetadata?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products        ProductCategory[]
  primaryProducts Product[]         @relation("PrimaryCategory")

  @@index([parentId, position])
  @@index([path])
  @@index([isActive, deletedAt])
  @@map("categories")
}

model Brand {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  logoId      String?
  websiteUrl  String?
  isActive    Boolean @default(true)
  seoId       String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  logo     Media?       @relation(fields: [logoId], references: [id], onDelete: SetNull)
  seo      SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([isActive, name])
  @@map("brands")
}

/// Merchandising grouping that cuts across the category tree ("New In", "Gift Guide").
model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  imageId     String?
  isActive    Boolean   @default(true)
  position    Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  /// Non-null means the collection is rule-driven rather than hand-picked.
  rules       Json?
  seoId       String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image    Media?              @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo      SeoMetadata?        @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products ProductCollection[]

  @@index([isActive, position])
  @@map("collections")
}

model Product {
  /// The supplier's identifier for this product, when it came from a feed.
  /// Matching on re-import prefers this over SKU: it survives a supplier
  /// renaming the product, which their SKU sometimes does not.
  externalId String?

  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  subtitle         String?
  /// One or two sentences for cards and meta descriptions.
  shortDescription String?
  description      String?       @db.Text
  status           ProductStatus @default(DRAFT)
  brandId          String?
  seoId            String?       @unique

  /// Product-level identifiers. Per-variant SKUs live on `Variant`; this is the
  /// parent/style code a supplier or accountant refers to.
  sku     String? @unique
  barcode String?

  /// Denormalised price range in *effective* cents (sale price where one is set),
  /// maintained from the variant set. Sorting and filtering 100k products by price
  /// must never require a join or an aggregate.
  minPriceCents Int    @default(0)
  maxPriceCents Int    @default(0)
  currency      String @default("USD")

  /// Denormalised review rollup — same reasoning as the price range.
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  /// Denormalised merchandising counters. `soldCount` drives the best-seller sort
  /// without aggregating over order items on every request.
  viewCount Int @default(0)
  soldCount Int @default(0)

  isFeatured   Boolean @default(false)
  isNewArrival Boolean @default(false)
  /// True when any variant has an active sale price. Maintained with the price range.
  isOnSale     Boolean @default(false)
  isAdultOnly  Boolean @default(true) // regulated category: age-gated by default

  /// Bullet list for the product page. Prose lives in `description`.
  features   String[] @default([])
  /// Free-form spec sheet for values that are displayed but never filtered on.
  attributes Json?

  /**
   * Flattened facet tokens — `["color:rose", "material:silicone", "tag:waterproof"]`.
   * This is the one denormalisation that makes multi-facet filtering viable at
   * scale. Filtering by colour through `VariantSelection -> Variant -> Product`
   * needs three joins per facet; a single GIN-indexed array answers any
   * combination with one index scan. Rebuilt from the source relations by
   * `rebuildProductFacets`.
   */
  facets String[] @default([])

  /// Canonical category, used to build the product's one true URL. Denormalised so
  /// generating a link never needs to sort the category join table.
  primaryCategoryId String?

  /// Per-product overrides. Null falls back to the store-wide policy in `Setting`.
  shippingNote     String?
  returnPolicyNote String?

  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  brand             Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  seo               SeoMetadata?           @relation(fields: [seoId], references: [id], onDelete: SetNull)
  primaryCategory   Category?              @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  categories        ProductCategory[]
  collections       ProductCollection[]
  media             ProductMedia[]
  options           VariantOption[]
  variants          Variant[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  tags              Tag[]
  productAttributes ProductAttribute[]
  relationsFrom     ProductRelation[]      @relation("RelationSource")
  relationsTo       ProductRelation[]      @relation("RelationTarget")
  recentlyViewed    RecentlyViewed[]
  searchDocument    ProductSearchDocument?
  analyticsEvents   AnalyticsEvent[]

  // Storefront listing: "active, not deleted, newest first".
  @@index([status, deletedAt, publishedAt])
  // Price and rating facets on a filtered listing.
  @@index([status, minPriceCents])
  @@index([status, ratingAverage])
  @@index([status, soldCount])
  @@index([brandId, status])
  @@index([isFeatured, status])
  @@index([isOnSale, status])
  @@index([isNewArrival, status])
  @@index([primaryCategoryId])
  // Multi-facet filtering. GIN is what makes `facets hasSome [...]` an index scan.
  @@index([facets], type: Gin)
  @@index([externalId])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
  @@map("product_collections")
}

model ProductMedia {
  productId String
  mediaId   String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, position])
  @@map("product_media")
}

/// An axis of variation for one product ("Colour", "Size").
model VariantOption {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  VariantOptionValue[]

  @@unique([productId, name])
  @@map("variant_options")
}

model VariantOptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String
  position Int    @default(0)

  option     VariantOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  selections VariantSelection[]

  @@unique([optionId, value])
  @@map("variant_option_values")
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  barcode   String?
  name      String // "Rose / Large"

  /**
   * Three price fields, because a storefront needs to answer three questions:
   * `priceCents`          the everyday list price
   * `salePriceCents`      an active promotional price, or null
   * `compareAtPriceCents` MSRP / anchor for a "compare at" strike-through
   * The *effective* price is `salePriceCents ?? priceCents`. Never re-derive that
   * inline — use `effectivePriceCents()` so the rule stays in one place.
   */
  priceCents          Int
  salePriceCents      Int?
  compareAtPriceCents Int?
  costCents           Int?

  /// Physical dimensions in whole millimetres and grams: integers, never floats.
  weightGrams        Int?
  lengthMm           Int?
  widthMm            Int?
  heightMm           Int?
  /// Category-specific and genuinely load-bearing for this shop's buyers.
  insertableLengthMm Int?
  diameterMm         Int?

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  selections    VariantSelection[]
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  stockAdjustments StockAdjustment[]

  @@index([productId, position])
  @@index([isActive, priceCents])
  @@index([isActive, salePriceCents])
  @@map("variants")
}

/// Resolves a variant to exactly one value per option axis.
model VariantSelection {
  variantId String
  valueId   String

  variant Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   VariantOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@index([valueId])
  @@map("variant_selections")
}

model Inventory {
  id        String @id @default(cuid())
  variantId String @unique

  /// Physically on hand. `available` = quantity - reserved.
  quantity          Int             @default(0)
  /// Held by in-flight checkouts; released on order completion or reservation expiry.
  reserved          Int             @default(0)
  lowStockThreshold Int             @default(5)
  policy            InventoryPolicy @default(DENY)
  location          String          @default("default")

  updatedAt DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([quantity])
  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id           String    @id @default(cuid())
  userId       String?
  /// Opaque cookie value for guest carts; merged into the user cart on sign-in.
  sessionToken String?   @unique
  currency     String    @default("USD")
  couponId     String?
  expiresAt    DateTime?

  /// Captured at checkout for a guest, so an order can be traced without an account.
  email    String?
  /// Free-text gift message, carried through to the order and the packing slip.
  giftNote String?

  /// Chosen shipping rate, held on the cart so totals survive a page reload.
  shippingRateId     String?
  /// Destination used for the tax and shipping estimate before an address exists.
  estimateState      String?
  estimatePostalCode String?

  /// Whether to spend loyalty on this basket. Intent only — the amounts are
  /// recomputed at checkout from the live balance, never trusted from here.
  applyStoreCredit Boolean @default(false)
  redeemPoints     Boolean @default(false)

  /// A gift card attached to this basket, by id. Intent only, like the flags
  /// above: the amount is quoted against the live balance at checkout, never
  /// taken from the client.
  giftCardId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingRate ShippingRate? @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)
  items        CartItem[]

  @@index([userId, updatedAt])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id             String @id @default(cuid())
  cartId         String
  variantId      String
  quantity       Int    @default(1)
  /// Price captured when added, so cart totals stay stable during a price change.
  unitPriceCents Int

  /**
   * Moved out of the active cart but kept for later.
   * A flag rather than a second table: it is the same row with the same variant
   * and quantity, and "save for later" then "move back" is a boolean flip rather
   * than a delete-and-recreate that loses the original price capture.
   */
  savedForLater Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders, payment and fulfilment
// ---------------------------------------------------------------------------

model Order {
  id          String  @id @default(cuid())
  /// Human-facing reference (GT-100042). Never expose `id` in emails or receipts.
  orderNumber String  @unique
  userId      String?
  email       String // kept separately: guest checkout, and users can change their email

  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  currency      String @default("USD")
  subtotalCents Int
  discountCents Int    @default(0)
  shippingCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int

  couponId          String?
  /// Code as entered, snapshotted — the coupon row may be edited or deleted later.
  couponCode        String?
  shippingAddressId String?
  billingAddressId  String?

  /**
   * The destination, snapshotted at checkout.
   * The `Address` rows above only exist for signed-in customers who chose to save
   * one — a guest has no account to hang an address off, so without this the
   * order records where to ship nothing at all, and it cannot be fulfilled.
   * Snapshotted rather than joined even when a row does exist: editing your
   * address book must not silently rewrite where a past order went.
   * Shape: `{ firstName, lastName, company, line1, line2, city, state, postalCode, country, phone }`.
   */
  shippingAddressSnapshot Json?
  billingAddressSnapshot  Json?

  /// Chosen shipping method, snapshotted by name so a rate change cannot rewrite history.
  shippingMethod      String?
  shippingRateId      String?
  estimatedDeliveryAt DateTime?

  /**
   * Per-jurisdiction tax breakdown: `[{ label, jurisdiction, ratePercent, amountCents }]`.
   * US sales tax is state plus county plus city, and a customer disputing a
   * charge — or an auditor — needs the split, not just the total. Snapshotted
   * because rates change and a past order must still explain itself.
   */
  taxBreakdown Json?

  /**
   * Loyalty tender applied to this order.
   * Deliberately *not* folded into `discountCents`. Store credit and points are
   * tender, not a discount: a discount reduces what is owed and therefore the
   * taxable base, while credit pays part of a bill that was already taxed in
   * full. Treating them the same under-collects tax.
   * So `totalCents` stays the full amount owed and keeps satisfying
   * `orders_total_is_sum`; the card is charged `totalCents - creditAppliedCents`.
   */
  creditAppliedCents Int @default(0)
  pointsRedeemed     Int @default(0)

  /**
   * Which implementation produced `taxCents`: "provider", "table" or "none".
   * Quoting fails open — if the tax provider is unreachable the seeded estimate
   * stands in so the store keeps taking orders. That trade is only defensible if
   * the affected orders can be found again, which is what this column is for.
   * Suffixed "-degraded" when a provider was configured but fell back.
   */
  taxSource String?

  customerNote String?
  giftNote     String?
  internalNote String?
  /// Provenance for fraud review and attribution.
  ipAddress    String?
  userAgent    String?

  placedAt    DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon          Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddress Address?           @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?           @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingRate    ShippingRate?      @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]
  returnRequests  ReturnRequest[]
  redemptions     CouponRedemption[]
  events          OrderEvent[]

  stockAdjustments     StockAdjustment[]
  staffNotes           StaffNote[]
  giftCardTransactions GiftCardTransaction[]
  /// Paid by gift card. Tender, like store credit — never a discount.
  giftCardAppliedCents Int                   @default(0)
  /// Fraud signals raised at checkout: ["velocity", "mismatched-billing"].
  riskFlags            String[]              @default([])
  /// 0-100, higher is riskier. Null until scored.
  riskScore            Int?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([email])
  @@map("orders")
}

/**
 * Append-only order timeline.
 * Every status change, payment attempt, email and note lands here and nothing is
 * ever updated or deleted. It powers the customer-facing timeline, answers "what
 * happened to order 100042" during a support call, and is the only record that
 * survives a bad admin edit.
 */
model OrderEvent {
  id                String         @id @default(cuid())
  orderId           String
  type              OrderEventType
  /// Human-readable summary, safe to show a customer.
  message           String
  /// Machine-readable detail: previous/next status, provider ids, error codes.
  data              Json?
  /// Null for anything the system did on its own.
  actorId           String?
  /// False for internal notes, so one query drives the customer timeline.
  isCustomerVisible Boolean        @default(true)
  createdAt         DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@map("order_events")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?

  /// Snapshot — the catalogue may be edited or deleted after the order is placed.
  productName String
  variantName String
  sku         String
  imageUrl    String?

  quantity       Int
  unitPriceCents Int
  discountCents  Int @default(0)
  taxCents       Int @default(0)
  totalCents     Int

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     Variant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// One row per gateway attempt. Multiple providers and split payments are supported
/// by design — the order's `paymentStatus` is the rollup.
model Payment {
  id             String          @id @default(cuid())
  orderId        String
  provider       PaymentProvider @default(KLARNA)
  status         PaymentStatus   @default(PENDING)
  amountCents    Int
  currency       String          @default("USD")
  /// Provider-side identifier (Klarna order id, PayPal capture id, ...).
  providerRef    String?
  /// Idempotency guard for webhook replays.
  idempotencyKey String?         @unique
  errorCode      String?
  errorMessage   String?
  metadata       Json?

  capturedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([orderId, status])
  @@map("payments")
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  carrier        ShippingCarrier @default(USPS)
  service        String? // "Priority Mail", "Ground Advantage"
  status         ShipmentStatus  @default(PENDING)
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  costCents      Int?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

/**
 * A purchasable shipping option.
 * Rates are data, not code, so operations can add "Free over $75" or change a
 * price without a deploy. `type` decides how `priceCents` is derived; carrier
 * integrations replace this table's *pricing* later without changing how the
 * cart or checkout consume it.
 */
model ShippingRate {
  id          String           @id @default(cuid())
  code        String           @unique // "standard", "express"
  name        String // shown at checkout
  description String?
  type        ShippingRateType @default(FLAT)

  baseCents       Int @default(0)
  /// WEIGHT_BASED only: added per kilogram above `freeWeightGrams`.
  perKgCents      Int @default(0)
  freeWeightGrams Int @default(0)

  /// Order subtotal at or above which this rate costs nothing. Null disables it.
  freeAboveSubtotalCents Int?
  /// Rate is offered only when the subtotal reaches this. Null means always.
  minSubtotalCents       Int?

  /// Empty means everywhere we ship. Populated restricts to these US states.
  states    String[] @default([])
  countries String[] @default(["US"])

  estimatedDaysMin Int             @default(3)
  estimatedDaysMax Int             @default(5)
  carrier          ShippingCarrier @default(USPS)

  isActive Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts  Cart[]
  orders Order[]

  @@index([isActive, position])
  @@map("shipping_rates")
}

/**
 * US sales tax rates, most specific match wins.
 * Deliberately a lookup table rather than a provider integration: at one
 * jurisdiction it is a row, and the service layer that reads it
 * (`tax.service.ts`) is the seam an Avalara or TaxJar adapter slots into later.
 * Rates are stored as basis points, not floats — 8.25% is `825`, so no rounding
 * error can creep into a tax figure that has to reconcile with a filing.
 */
model TaxRate {
  id String @id @default(cuid())

  country    String  @default("US")
  /// Two-letter state code. Null matches any state in the country.
  state      String?
  /// More specific than state. Null matches any county.
  county     String?
  /// Most specific of all. Null matches any postal code.
  postalCode String?

  label             String // "California state tax"
  /// Basis points: 825 = 8.25%.
  rateBasisPoints   Int
  /// Some states tax shipping, some do not.
  appliesToShipping Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resolution order is postal -> county -> state, so this index serves all three.
  @@index([country, state, county, postalCode])
  @@index([isActive])
  @@map("tax_rates")
}

/**
 * Marketing consent, keyed by email rather than by user.
 * A guest who ticks "email me offers" at checkout has no `User` row to hold
 * `acceptsMarketing`, and consent is exactly the thing that must be recorded with
 * its own timestamp and source — "when and how did they agree" is the first
 * question asked in any CAN-SPAM or GDPR complaint.
 */
model NewsletterSubscriber {
  id     String @id @default(cuid())
  email  String @unique
  /// Where the opt-in happened: "checkout", "footer", "popup".
  source String @default("unknown")

  /// Null while unconfirmed, set on double opt-in.
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  /// Single-use token for the confirm and unsubscribe links in every email.
  token          String    @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unsubscribedAt])
  @@map("newsletter_subscribers")
}

/// Addresses we must stop sending to, and why.
///
/// A hard bounce means the mailbox does not exist; a complaint means someone
/// pressed "report spam". Continuing to send to either is the fastest way to
/// destroy a sending reputation — and reputation is shared across the whole
/// domain, so one ignored bounce list degrades password resets too.
///
/// Kept as its own table rather than a flag on `users` because most bounces are
/// for addresses that never became accounts: guest checkouts, newsletter
/// signups, and typos.
model EmailSuppression {
  id     String              @id @default(cuid())
  email  String              @unique
  reason EmailSuppressionType

  /// Provider-side message id, so a suppression is traceable to one send.
  providerMessageId String?
  /// The provider's own description. Useful when a bounce is not what it looks like.
  detail            String?

  /// Soft bounces are counted rather than acted on: a full mailbox is temporary,
  /// and suppressing on the first one loses a customer over a busy inbox.
  /// Three inside seven days is treated as hard.
  softBounceCount Int       @default(0)
  lastBounceAt    DateTime?

  /// Set when an address is deliberately released — a customer who fixed their
  /// mailbox and asked. Never automatic: an address that bounced once and then
  /// silently resumed is how a reputation problem returns.
  releasedAt DateTime?
  releasedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reason, releasedAt])
  @@map("email_suppressions")
}

enum EmailSuppressionType {
  /// Mailbox does not exist. Permanent.
  HARD_BOUNCE
  /// Repeated temporary failures. Promoted from soft after three in a week.
  SOFT_BOUNCE
  /// The recipient pressed "report spam". Permanent, and never overridable by
  /// a preference screen.
  COMPLAINT
  /// Added by an operator.
  MANUAL
}

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  description       String?
  type              DiscountType @default(PERCENTAGE)
  /// Percentage points for PERCENTAGE, cents for FIXED_AMOUNT, ignored for FREE_SHIPPING.
  value             Int
  minSubtotalCents  Int?
  maxDiscountCents  Int?
  usageLimit        Int? // null = unlimited
  usageLimitPerUser Int?
  usedCount         Int          @default(0)
  isActive          Boolean      @default(true)
  startsAt          DateTime?
  endsAt            DateTime?

  /**
   * Customer-specific coupon.
   * Non-null restricts redemption to one account — win-back offers, service
   * recovery, influencer codes. Enforced server-side in `coupon.service.ts`, not
   * by obscurity: a code that only works for one person must still reject
   * everyone else who guesses it.
   */
  userId         String?
  /// Restricts to customers who have never ordered before.
  firstOrderOnly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  carts       Cart[]
  orders      Order[]
  redemptions CouponRedemption[]

  @@index([isActive, endsAt])
  @@index([userId])
  @@map("coupons")
}

/// Enforces per-user usage limits and gives finance a redemption ledger.
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  userId        String?
  orderId       String
  discountCents Int
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// Social proof and saved items
// ---------------------------------------------------------------------------

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String?
  authorName         String
  rating             Int // 1..5, enforced by a check constraint in the migration
  title              String?
  body               String       @db.Text
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  helpfulCount       Int          @default(0)
  moderatedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  images  ReviewImage[]
  votes   ReviewVote[]

  // One review per customer per product.
  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  // "Most helpful" and "highest rated" sorts on a product's review list.
  @@index([productId, status, helpfulCount])
  @@index([productId, status, rating])
  @@index([status, createdAt])
  @@map("reviews")
}

/// Customer-submitted photos. Moderated with the parent review, never separately.
model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  publicId  String?
  alt       String?
  width     Int?
  height    Int?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, position])
  @@map("review_images")
}

/**
 * "Was this helpful?" votes.
 * A row per voter rather than a bare counter, because an incrementable integer can
 * be clicked a thousand times by one person. `Review.helpfulCount` is the
 * denormalised rollup for sorting; this table is the truth.
 */
model ReviewVote {
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
  @@map("review_votes")
}

model Wishlist {
  id         String  @id @default(cuid())
  userId     String
  name       String  @default("My Wishlist")
  /// Share token for a public wishlist URL; null while private.
  shareToken String? @unique
  isDefault  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@index([productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Editorial
// ---------------------------------------------------------------------------

model Post {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String?
  content        String     @db.Text
  status         PostStatus @default(DRAFT)
  coverImageId   String?
  authorName     String
  readingMinutes Int        @default(1)
  seoId          String?    @unique
  publishedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  coverImage Media?       @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  seo        SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)
  tags       Tag[]

  @@index([status, publishedAt])
  @@map("posts")
}

/// Shared vocabulary for both editorial posts and products, so "waterproof" means
/// the same thing in a guide and on a listing filter.
model Tag {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  /// Surfaced as a filter chip on the listing page when true.
  isFilterable Boolean @default(false)

  posts    Post[]
  products Product[]

  @@index([isFilterable])
  @@map("tags")
}

/// CMS-managed static content (privacy policy, shipping info, ...).
model Page {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  content     String     @db.Text
  status      PostStatus @default(DRAFT)
  seoId       String?    @unique
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seo SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("pages")
}

// ---------------------------------------------------------------------------
// Platform: settings, notifications, audit, import
// ---------------------------------------------------------------------------

/// Runtime configuration that must be editable without a deploy. Anything that is a
/// secret or a build-time concern belongs in the environment, not here.
model Setting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

model Notification {
  id      String              @id @default(cuid())
  userId  String
  channel NotificationChannel @default(IN_APP)
  type    String // "order.shipped", "review.approved", ...
  title   String
  body    String
  data    Json?
  readAt  DateTime?
  sentAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String // "Product", "Order", ...
  entityId   String
  /// Field-level before/after diff. Never store secrets or full card data here.
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalogue: attributes, relations, discovery
// ---------------------------------------------------------------------------

/**
 * Attribute vocabulary.
 * Defined as data rather than as columns, so merchandising can add "Battery life"
 * without a migration. `isFilterable` decides whether values become facet tokens
 * on `Product.facets`; everything else is display-only.
 */
model AttributeDefinition {
  id           String        @id @default(cuid())
  key          String        @unique // "material", "waterproof", "noise-level"
  label        String // "Material"
  type         AttributeType @default(TEXT)
  unit         String? // "dB", "mm", "hours"
  /// Fixed option list for ENUM attributes.
  options      String[]      @default([])
  isFilterable Boolean       @default(false)
  /// Shown in the product page specification table.
  isSpec       Boolean       @default(true)
  position     Int           @default(0)
  group        String        @default("general") // spec-table section heading

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ProductAttribute[]

  @@index([isFilterable])
  @@index([group, position])
  @@map("attribute_definitions")
}

model ProductAttribute {
  productId    String
  definitionId String
  /// Stored as text and cast on read; `AttributeDefinition.type` says how.
  value        String

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@id([productId, definitionId])
  // Serves "every product whose material is silicone" before facets are rebuilt.
  @@index([definitionId, value])
  @@map("product_attributes")
}

/**
 * Product-to-product links: related items, frequently-bought-together, upsells.
 * Directional and explicitly positioned, because merchandising order is a
 * commercial decision. `position` is honoured on read; ties fall back to the
 * target's sales rank.
 */
model ProductRelation {
  id        String              @id @default(cuid())
  productId String
  relatedId String
  type      ProductRelationType @default(RELATED)
  position  Int                 @default(0)
  /// Set by a recommender rather than a human. Null means hand-curated.
  score     Float?
  createdAt DateTime            @default(now())

  product Product @relation("RelationSource", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, type])
  @@index([productId, type, position])
  @@map("product_relations")
}

/**
 * Recently viewed, for signed-in customers.
 * Guests are tracked in `localStorage` — see `useRecentlyViewed`. Persisting here
 * as well is what makes the list survive a device change, and later feeds
 * recommendations. Capped per user by `trimRecentlyViewed`.
 */
model RecentlyViewed {
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

/**
 * Search index.
 * A denormalised text document per product, so full-text search never joins across
 * brand, category and variant tables. The actual index is a Postgres GIN index over
 * `to_tsvector('english', content)` plus a `pg_trgm` index for fuzzy matching —
 * both added by raw SQL in the migration, because Prisma cannot express a
 * functional index. Look in the `phase3_catalog` migration SQL.
 * The title is repeated into `content` when the document is built, which gives
 * title matches a higher natural rank without needing `setweight` at query time.
 */
model ProductSearchDocument {
  productId    String   @id
  title        String
  brandName    String?
  categoryPath String?
  keywords     String[] @default([])
  /// Everything searchable, concatenated. Rebuilt by `rebuildSearchDocument`.
  content      String   @db.Text
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_search_documents")
}

/**
 * Search telemetry: powers "popular" and "trending" suggestions, and shows which
 * queries return nothing so the catalogue team can fix the gap.
 */
model SearchQuery {
  id          String   @id @default(cuid())
  /// Normalised (trimmed, lower-cased) so counts aggregate correctly.
  term        String
  resultCount Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())

  @@index([term, createdAt])
  // "Trending in the last 24 hours".
  @@index([createdAt])
  // "Queries that returned nothing", for merchandising.
  @@index([resultCount, createdAt])
  @@map("search_queries")
}

/// Bookkeeping for the future catalogue import pipeline. The adapters themselves are
/// deliberately not implemented yet — see src/features/import/.
model ImportJob {
  id            String           @id @default(cuid())
  sourceType    ImportSourceType
  sourceName    String
  status        ImportJobStatus  @default(QUEUED)
  /// Adapter-specific configuration (URL, credentials reference, field mapping).
  config        Json?
  totalRows     Int              @default(0)
  processedRows Int              @default(0)
  failedRows    Int              @default(0)
  errors        Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  /// A dry run writes rows and reports outcomes but persists no products.
  isDryRun     Boolean   @default(false)
  /// Set once a rollback has been applied, so it cannot be applied twice.
  rolledBackAt DateTime?
  templateId   String?
  createdById  String?

  template ImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  rows     ImportRow[]

  @@index([status, createdAt])
  @@index([templateId])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Customer account — phase 5
// ---------------------------------------------------------------------------

/// What a customer can be notified about. Channels are columns; topics are rows.
enum NotificationTopic {
  ORDER_UPDATES
  SHIPPING_UPDATES
  RETURNS
  PROMOTIONS
  NEWSLETTER
  PRODUCT_BACK_IN_STOCK
  REVIEW_REMINDERS
  SECURITY_ALERTS
}

enum ReturnStatus {
  /// Customer submitted it; nobody has looked yet.
  REQUESTED
  APPROVED
  REJECTED
  /// Label issued, parcel not yet scanned.
  IN_TRANSIT
  RECEIVED
  /// Inspected and refunded.
  REFUNDED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  NOT_AS_DESCRIBED
  WRONG_ITEM
  ARRIVED_LATE
  CHANGED_MIND
  QUALITY
  OTHER
}

/// Every movement in a reward balance. Points and credit share one ledger.
enum RewardTransactionType {
  EARNED_PURCHASE
  EARNED_REVIEW
  EARNED_REFERRAL
  EARNED_BIRTHDAY
  REDEEMED
  ADJUSTMENT
  EXPIRED
  /// Money, not points — a gift card or service-recovery credit.
  STORE_CREDIT
}

enum VipTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum LoginOutcome {
  SUCCESS
  BAD_PASSWORD
  UNKNOWN_EMAIL
  LOCKED
  /// Reached the second factor but failed it.
  FAILED_2FA
}

/**
 * Per-customer settings that are not identity.
 * One row, created lazily on first save. Separate from `User` because these are
 * read on a handful of pages while `User` is read on nearly every request — and
 * because "who you are" and "how you like things" have different write patterns.
 */
model UserPreferences {
  userId String @id

  /// IANA zone, e.g. "America/New_York". Dates render in the customer's own time.
  timezone String @default("America/New_York")
  /// BCP-47 tag. Only "en-US" is served today; the column is what makes adding a
  /// second locale a data change rather than a schema change.
  locale   String @default("en-US")
  currency String @default("USD")

  /// Drives the "finish setting up your account" nudge on the dashboard.
  onboardingCompletedAt DateTime?
  /// For birthday rewards. Day and month only — the year is not collected.
  birthMonth            Int?
  birthDay              Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/**
 * One row per customer per topic.
 * Rows rather than a column per topic-and-channel: adding a topic becomes an
 * insert instead of a migration, and a missing row means "the default for that
 * topic" rather than "off" — which matters, because order updates must never
 * silently stop because a row was never written.
 */
model NotificationPreference {
  userId String
  topic  NotificationTopic

  email Boolean @default(true)
  /// Both are architecture. No SMS or push provider is wired up yet.
  sms   Boolean @default(false)
  push  Boolean @default(false)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic])
  @@map("notification_preferences")
}

/**
 * A card on file, by reference only.
 * **No card data is stored here and none may ever be.** `providerRef` is a Stripe
 * PaymentMethod id; `brand`, `last4` and the expiry are the display fragments
 * Stripe itself returns, enough to render "Visa ending 4242". Storing a card
 * number — even encrypted — moves this store out of PCI SAQ-A into a scope that
 * needs an annual audit. That is a business decision, not an engineering one.
 */
model SavedPaymentMethod {
  id     String @id @default(cuid())
  userId String

  provider    PaymentProvider @default(STRIPE)
  /// Stripe Customer id. Needed to list or detach the method later.
  customerRef String
  /// Stripe PaymentMethod id — the only handle we hold on the card.
  providerRef String          @unique

  brand     String?
  last4     String?
  expMonth  Int?
  expYear   Int?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("saved_payment_methods")
}

/**
 * A signed-in device.
 * Sessions live in a JWT, so this table does not authenticate anyone — it exists
 * so a customer can *see* where they are signed in and revoke it. The JWT carries
 * this row's id, and `revokedAt` is checked on every authenticated request — a
 * primary-key lookup — so revoking a device takes effect on its very next request.
 */
model UserSession {
  id     String @id @default(cuid())
  userId String

  userAgent String?
  ipAddress String?
  /// Coarse location for the "signed in from" line. City-level at most.
  location  String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastSeenAt])
  @@map("user_sessions")
}

/**
 * Sign-in attempts, successful or not.
 * Shown to the customer as recent activity, and kept as the evidence trail for an
 * account-takeover investigation. Failures are recorded too: three bad passwords
 * from a country the customer has never visited is the signal, and it only exists
 * if the failures were written down.
 */
model LoginEvent {
  id     String  @id @default(cuid())
  /// Null when the email matched no account — there is nobody to attribute it to.
  userId String?
  /// Recorded even when `userId` is null, so attempts against a non-existent
  /// account are still countable.
  email  String

  outcome   LoginOutcome
  /// "credentials", "google", ...
  method    String       @default("credentials")
  ipAddress String?
  userAgent String?
  location  String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_events")
}

/**
 * A customer's loyalty balances.
 * The balances are cached aggregates; `RewardTransaction` is the truth. Storing
 * the running total avoids summing a lifetime of rows to render a badge, and any
 * disagreement between the two is a bug that the ledger wins.
 * **No business rules are implemented.** Nothing earns, expires or redeems yet —
 * this is the shape those rules will eventually write into.
 */
model RewardAccount {
  userId String @id

  pointsBalance    Int       @default(0)
  /// Money, in cents, like every other amount in this system.
  storeCreditCents Int       @default(0)
  tier             VipTier   @default(STANDARD)
  tierReviewedAt   DateTime?

  /// Last birthday grant, so the annual reward pays once a year and not once a visit.
  lastBirthdayGrantAt DateTime?
  /// The code this customer signed up with, and when their referrer was paid.
  referredByCode      String?
  referralPaidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions RewardTransaction[]

  @@map("reward_accounts")
}

model RewardTransaction {
  id     String @id @default(cuid())
  userId String

  type        RewardTransactionType
  /// Signed. Negative is a redemption or an expiry.
  points      Int                   @default(0)
  amountCents Int                   @default(0)

  /// Customer-facing: "Order GT-100042", "Referred a friend".
  description String
  orderId     String?
  /// Null means it never expires.
  expiresAt   DateTime?

  createdAt DateTime @default(now())

  account RewardAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reward_transactions")
}

/**
 * A customer's referral code.
 * One per customer, created on demand. `uses` is denormalised for display; the
 * authoritative count is the reward transactions attributed to it.
 */
model ReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  code   String @unique

  uses        Int  @default(0)
  /// What the referred friend gets. Null until the programme is configured.
  rewardCents Int?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

/**
 * A request to send something back.
 * Its own aggregate rather than a flag on `Order`, because a return has its own
 * lifecycle, its own timeline and its own subset of line items — an order can be
 * partly returned twice, for different reasons, weeks apart.
 * The approval workflow is architecture: the statuses and their transitions exist,
 * and the admin UI that drives them arrives in a later phase.
 */
model ReturnRequest {
  id           String  @id @default(cuid())
  /// Human-facing, like an order number: "RMA-100042".
  returnNumber String  @unique
  orderId      String
  userId       String?

  status  ReturnStatus @default(REQUESTED)
  reason  ReturnReason
  /// The customer's own words, shown to whoever reviews it.
  comment String?

  /// Filled in once inspected. Not necessarily the sum of the items' prices — a
  /// restocking fee or a partial refund is a judgement call.
  refundCents Int?
  refundedAt  DateTime?

  /// Return shipping, once a label exists.
  carrier        ShippingCarrier?
  trackingNumber String?
  trackingUrl    String?

  /// Set when a reviewer acts. Null while REQUESTED.
  reviewedAt   DateTime?
  reviewerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items ReturnItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String

  quantity  Int
  reason    ReturnReason
  /// Recorded on inspection: "unopened", "opened", "damaged".
  condition String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@map("return_items")
}

// ---------------------------------------------------------------------------
// Phase 6 â€” administration
//
// Deliberately small. Phase 1 already modelled Media (with a `folder`), Setting,
// Page, Post, Tag, SeoMetadata, Collection (with `rules` and a scheduling
// window), Inventory, AuditLog, Notification, and Role/Permission with an
// `isSystem` flag that custom roles need. What follows is only what was
// genuinely missing â€” not a parallel set of admin tables shadowing those.
// ---------------------------------------------------------------------------

enum StockAdjustmentReason {
  RECEIVED // stock arrived
  SOLD // decremented by an order
  RETURNED // came back from a customer
  DAMAGED
  LOST // shrinkage, theft, unexplained
  RECOUNT // a physical count disagreed with the system
  CORRECTION // fixing an earlier mistake
  TRANSFER // moved between locations
}

/// Every change to a stock number, with who made it and why.
///
/// `Inventory` holds the current count; this holds how it got there. Without it
/// "we are forty units short" has no answer, and a stock adjustment is the
/// single easiest place in an ecommerce system to hide theft.
///
/// `quantityAfter` is stored rather than derived: replaying thousands of deltas
/// to answer "what did the system believe on the 3rd?" is slow, and wrong the
/// moment one row is deleted.
model StockAdjustment {
  id            String                @id @default(cuid())
  variantId     String
  reason        StockAdjustmentReason
  /// Signed. Negative removes stock.
  delta         Int
  quantityAfter Int
  note          String?
  /// Set when an order caused this, so the two records can be reconciled.
  orderId       String?
  actorId       String?
  location      String                @default("default")

  createdAt DateTime @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User?   @relation("StockAdjustedBy", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("stock_adjustments")
}

/// URL redirects, managed by whoever changes a slug rather than by a deploy.
///
/// Renaming a category is a five-second edit that silently 404s every inbound
/// link and every ranking it had. `hits` and `lastHitAt` exist so dead
/// redirects can eventually be retired with evidence rather than by guesswork.
model Redirect {
  id          String    @id @default(cuid())
  /// Path only, leading slash, no host: "/collections/first-toy".
  source      String    @unique
  destination String
  /// 301 permanent or 302 temporary. The wrong choice is cached for months.
  statusCode  Int       @default(301)
  isActive    Boolean   @default(true)
  note        String?
  hits        Int       @default(0)
  lastHitAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  creator User? @relation("RedirectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([isActive, source])
  @@map("redirects")
}

enum ContentBlockType {
  ANNOUNCEMENT // the thin bar above the header
  HOME_BANNER // homepage promotional slot
  FAQ // a question and its answer
  FOOTER_LINK
}

/// Small editable content, in one table rather than four.
///
/// Announcements, homepage banners, FAQs and footer links differ only in where
/// they render and which optional fields they use. Four near-identical tables
/// would mean four near-identical admin screens, and four migrations the next
/// time someone wants a scheduling window on one of them.
///
/// `Page` and `Post` stay separate: they carry long-form content, their own
/// URLs and their own SEO records, which is a genuinely different shape.
model ContentBlock {
  id        String           @id @default(cuid())
  type      ContentBlockType
  title     String
  body      String?          @db.Text
  /// Where it points, when it points anywhere.
  linkUrl   String?
  linkLabel String?
  imageId   String?
  /// FAQ grouping, or a banner slot name. Meaning depends on `type`.
  group     String?
  position  Int              @default(0)
  isActive  Boolean          @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image Media? @relation("ContentBlockImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([type, isActive, position])
  @@map("content_blocks")
}

/// Navigation menus, stored as a tree of rows.
///
/// An adjacency list rather than nested JSON: an editor reorders one item at a
/// time, and a JSON blob turns every reorder into a read-modify-write race
/// between two people editing the header at once.
model NavigationMenu {
  id        String   @id @default(cuid())
  /// "header", "footer-help", "footer-shop" â€” referenced by the storefront.
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NavigationItem[]

  @@map("navigation_menus")
}

model NavigationItem {
  id         String  @id @default(cuid())
  menuId     String
  parentId   String?
  label      String
  url        String
  position   Int     @default(0)
  isActive   Boolean @default(true)
  /// Opens in a new tab. Rare, but the alternative is editors pasting raw HTML.
  isExternal Boolean @default(false)

  menu     NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem?  @relation("NavItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavItemChildren")

  @@index([menuId, parentId, position])
  @@map("navigation_items")
}

/// Free-text notes staff leave on a customer or an order.
///
/// One table for both, because the alternative is two identical ones. Exactly
/// one of `userId` / `orderId` is set â€” enforced by a check constraint in the
/// migration, since Prisma cannot express "exactly one of these".
///
/// `isPinned` exists because the note that matters ("do not ship to the billing
/// address, they have asked twice") must not scroll away under twenty routine
/// ones.
model StaffNote {
  id       String  @id @default(cuid())
  userId   String?
  orderId  String?
  authorId String?
  body     String  @db.Text
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?  @relation("StaffNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User?  @relation("StaffNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId, createdAt])
  @@map("staff_notes")
}

/// A saved customer filter.
///
/// Stores the query, not the membership. A segment whose members were frozen at
/// creation is a mailing list with a misleading name â€” "spent over $500 in the
/// last year" has to be re-evaluated to mean anything at all.
model CustomerSegment {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  /// `{ minOrders, minSpendCents, tier, tags, joinedBefore, ... }`
  rules       Json
  /// Cached count and when it was taken, so the list can show a number without
  /// running every segment's query on page load.
  cachedCount Int?      @default(0)
  countedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_segments")
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

/// Gift cards â€” schema and admin only. Nothing at checkout redeems one yet.
///
/// Modelled now because a balance has to be a ledger from the first day.
/// Retrofitting one onto a mutable `balanceCents` column leaves a stretch of
/// history where "why is this card empty?" has no answer.
///
/// The code is hashed for the same reason a password is: a leaked database
/// should not be a stack of bearer instruments.
model GiftCard {
  id            String         @id @default(cuid())
  /// Last four of the code, so support can identify a card without holding it.
  last4         String
  codeHash      String         @unique
  status        GiftCardStatus @default(ACTIVE)
  initialCents  Int
  balanceCents  Int
  currency      String         @default("USD")
  issuedToEmail String?
  note          String?
  expiresAt     DateTime?
  issuedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issuedBy     User?                 @relation("GiftCardIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  transactions GiftCardTransaction[]

  @@index([status, createdAt])
  @@map("gift_cards")
}

enum AdminAlertLevel {
  INFO
  WARNING
  CRITICAL
}

/// Store-wide operational alerts: a new order, stock running out, a failed payment.
///
/// Separate from `Notification`, which belongs to one customer. These belong to
/// whoever is on shift, so they are addressed by permission rather than by user
/// â€” routing "low stock" to a named person means it goes unread the week they
/// are on holiday.
///
/// `dedupeKey` collapses the fortieth low-stock alert for the same variant into
/// the first. An inbox nobody can clear is an inbox nobody reads.
model AdminAlert {
  id         String          @id @default(cuid())
  level      AdminAlertLevel @default(INFO)
  /// "order.created", "inventory.low", "payment.failed", ...
  type       String
  title      String
  body       String?
  /// Where clicking it should go.
  href       String?
  /// Only staff holding this permission see the alert.
  permission String?
  dedupeKey  String?         @unique
  data       Json?
  readAt     DateTime?
  readById   String?
  createdAt  DateTime        @default(now())

  readBy User? @relation("AdminAlertReadBy", fields: [readById], references: [id], onDelete: SetNull)

  @@index([readAt, createdAt])
  @@index([type, createdAt])
  @@map("admin_alerts")
}

enum GiftCardTransactionType {
  ISSUED
  REDEEMED
  REFUNDED // an order was refunded, value returned to the card
  ADJUSTED // manual correction by staff
  EXPIRED
  CANCELLED
}

/// Every movement on a gift card balance.
///
/// `GiftCard.balanceCents` is a cache; this is the truth, and the balance is the
/// sum of these rows. A gift card is a liability the business owes the bearer —
/// "why is this card empty?" has to have an answer, and a mutable column alone
/// cannot give one.
///
/// `balanceAfter` is stored rather than replayed for the same reason the stock
/// ledger stores it: reconstructing a balance from deltas is slow and wrong the
/// moment one row is deleted.
model GiftCardTransaction {
  id           String                  @id @default(cuid())
  giftCardId   String
  type         GiftCardTransactionType
  /// Signed. Negative spends, positive adds.
  amountCents  Int
  balanceAfter Int
  orderId      String?
  actorId      String?
  note         String?

  createdAt DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor    User?    @relation("GiftCardAdjustedBy", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([giftCardId, createdAt])
  @@index([orderId])
  @@map("gift_card_transactions")
}

// ---------------------------------------------------------------------------
// Phase 7 — scale, ingestion, search, analytics
// ---------------------------------------------------------------------------

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  /// Exhausted its retries. Kept forever; this is the dead-letter queue.
  DEAD
  CANCELLED
}

/// The background job queue.
///
/// Postgres, not Redis. `SELECT ... FOR UPDATE SKIP LOCKED` gives exactly-once
/// claiming across any number of workers, which is the only hard part of a
/// queue, and it comes with the database already in the stack. A dedicated
/// broker earns its operational cost somewhere north of a few thousand jobs a
/// second; this catalogue will not see that, and the day it does, the adapter
/// boundary in `lib/jobs` is where a broker slots in.
///
/// Every row is its own audit trail: what ran, when, how often it failed and
/// with what error.
model BackgroundJob {
  id       String    @id @default(cuid())
  /// Handler key, e.g. `import.run`, `price.sync`, `email.send`.
  kind     String
  status   JobStatus @default(QUEUED)
  /// Handler input. Never secrets — this table is readable and backed up.
  payload  Json      @default("{}")
  /// Lower runs first; ties break by `runAt`.
  priority Int       @default(100)

  /// When it becomes eligible. Future-dated rows are how scheduling works.
  runAt       DateTime @default(now())
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)

  /// Set while a worker holds it. A stale lock is how a crashed worker is found.
  lockedAt DateTime?
  lockedBy String?

  lastError String? @db.Text
  result    Json?

  /// Collapses duplicate work: two "reindex product X" requests are one job.
  dedupeKey String? @unique

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  scheduleId String?
  schedule   ScheduledJob? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  /// The claim query: eligible rows, best first.
  @@index([status, runAt, priority])
  @@index([kind, status])
  /// Finding jobs abandoned by a dead worker.
  @@index([lockedAt])
  @@map("background_jobs")
}

/// A recurring job definition. The runner enqueues from these.
model ScheduledJob {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  kind        String
  payload     Json    @default("{}")
  /// Standard five-field cron.
  cron        String
  isActive    Boolean @default(true)
  description String?

  lastRunAt  DateTime?
  nextRunAt  DateTime?
  lastStatus JobStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs BackgroundJob[]

  @@index([isActive, nextRunAt])
  @@map("scheduled_jobs")
}

/// A saved field mapping for one supplier's feed.
///
/// Suppliers do not agree on column names and never will. A template is the
/// translation from their vocabulary to ours, saved once so the second import
/// from the same supplier is a click rather than a re-derivation.
model ImportTemplate {
  id         String           @id @default(cuid())
  name       String
  sourceType ImportSourceType
  /// `{ ourField: "their column" }`, plus per-field transforms.
  mapping    Json
  /// Defaults applied to every row (currency, brand, category).
  defaults   Json?
  /// Feed URL, auth reference, delimiter, encoding. Never a secret itself.
  config     Json?
  isActive   Boolean          @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?       @relation("ImportTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  jobs      ImportJob[]

  @@unique([name, sourceType])
  @@map("import_templates")
}

enum ImportRowOutcome {
  CREATED
  UPDATED
  SKIPPED
  FAILED
  /// Matched an existing product but the values conflicted.
  CONFLICT
}

/// One row of one import.
///
/// The unit of "what actually happened", and the unit of rollback. Storing the
/// before-image per row is what makes an import reversible: undoing a bad
/// price feed means replaying these backwards, which is impossible if all you
/// kept was a success count.
model ImportRow {
  id         String           @id @default(cuid())
  jobId      String
  rowNumber  Int
  outcome    ImportRowOutcome
  /// Supplier's identifier for this row, for matching on re-import.
  externalId String?
  sku        String?
  productId  String?
  /// The product's values before this row touched it. Null on create.
  before     Json?
  /// What the row asked for, after mapping and normalisation.
  after      Json?
  message    String?          @db.Text

  createdAt DateTime @default(now())

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, outcome])
  @@index([jobId, rowNumber])
  @@index([externalId])
  @@map("import_rows")
}

/// Server-side analytics.
///
/// Deliberately first-party and deliberately not personal. There is a session
/// id and an optional user id, no fingerprint, no cross-site identifier: this
/// exists to answer "which products sell and where do people drop out", not to
/// follow anyone around. GA4 and the pixels are configured separately and
/// consent-gated; this table works when they are all switched off.
model AnalyticsEvent {
  id        String  @id @default(cuid())
  /// `page_view`, `product_view`, `search`, `add_to_cart`, `purchase`, ...
  name      String
  sessionId String
  userId    String?

  path       String?
  productId  String?
  variantId  String?
  orderId    String?
  searchTerm String?

  /// Money in cents, so revenue reporting needs no float arithmetic.
  valueCents Int?
  quantity   Int?

  /// utm_source / utm_medium / utm_campaign, and the referring host.
  source   String?
  medium   String?
  campaign String?
  referrer String?

  /// `mobile` | `tablet` | `desktop`, derived from the user agent at write time.
  device  String?
  country String?

  /// Anything event-specific that does not deserve a column.
  meta Json?

  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// The three shapes every dashboard query takes.
  @@index([name, createdAt])
  @@index([sessionId, createdAt])
  @@index([productId, name, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

/// Pre-aggregated daily rollups.
///
/// A dashboard that scans the raw event table works at ten thousand rows and
/// falls over at ten million. The rollup job writes one row per day per metric;
/// the dashboard reads those. Raw events stay for drill-down and pruning.
model AnalyticsDaily {
  id         String   @id @default(cuid())
  day        DateTime @db.Date
  metric     String
  /// Optional breakdown: a product id, a source, a device.
  dimension  String?
  value      Int      @default(0)
  valueCents Int      @default(0)

  updatedAt DateTime @updatedAt

  @@unique([day, metric, dimension])
  @@index([metric, day])
  @@map("analytics_daily")
}

enum SeoIssueSeverity {
  CRITICAL
  WARNING
  NOTICE
}

/// A run of the SEO health check.
model SeoAudit {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Pages examined.
  checked    Int       @default(0)
  critical   Int       @default(0)
  warnings   Int       @default(0)
  notices    Int       @default(0)
  summary    Json?

  issues SeoIssue[]

  @@index([startedAt])
  @@map("seo_audits")
}

/// One finding: a missing title, a duplicate description, a broken link.
model SeoIssue {
  id         String           @id @default(cuid())
  auditId    String
  severity   SeoIssueSeverity
  /// `missing_title`, `duplicate_description`, `broken_link`, `orphan_page`, ...
  code       String
  url        String
  message    String
  /// The offending value, so a fix does not require re-finding it.
  detail     String?
  entityType String?
  entityId   String?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  audit SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, severity])
  @@index([code, resolvedAt])
  @@map("seo_issues")
}

enum MarketingProvider {
  /// Cookieless first-party beacon. The only tag here that needs no consent.
  CLOUDFLARE_WEB_ANALYTICS
  GA4
  GTM
  GOOGLE_ADS
  GOOGLE_MERCHANT
  GOOGLE_SEARCH_CONSOLE
  META_PIXEL
  TIKTOK_PIXEL
  PINTEREST_TAG
  MICROSOFT_UET
  LINKEDIN_INSIGHT
}

/// A marketing tag's configuration.
///
/// Only the public identifier lives here — a GA4 measurement id or a pixel id
/// is emitted into the page anyway, so it is not a secret. API secrets stay in
/// the environment; this table exists so switching a pixel on is a setting
/// rather than a deploy, and so consent can gate the whole set at once.
model MarketingIntegration {
  id              String            @id @default(cuid())
  provider        MarketingProvider @unique
  isEnabled       Boolean           @default(false)
  /// Measurement id, pixel id, container id. Public by design.
  publicId        String?
  /// Non-secret extras: conversion labels, feed options.
  config          Json?
  /// Whether this tag waits for analytics consent. Advertising tags must.
  requiresConsent Boolean           @default(true)
  notes           String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("MarketingIntegrationEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("marketing_integrations")
}

/// Query rewriting for search: synonyms, and one-way expansions.
///
/// "Bullet" and "mini vibrator" are the same intent to a customer and different
/// strings to Postgres. Curated by merchandisers, applied at query time.
model SearchSynonym {
  id        String   @id @default(cuid())
  term      String
  synonyms  String[] @default([])
  /// One-way: `term` expands to `synonyms`, but not the reverse.
  isOneWay  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([term])
  @@map("search_synonyms")
}

/// What the image pipeline did to an asset, and what it saved.
///
/// Kept because "why is this page slow" is usually answered by a 4MB hero, and
/// because a compression step that silently stopped running is invisible
/// without a record of it having run.
model MediaOptimizationLog {
  id             String  @id @default(cuid())
  mediaId        String
  /// `upload`, `resize`, `webp`, `avif`, `dedupe`.
  operation      String
  originalBytes  Int?
  optimizedBytes Int?
  format         String?
  width          Int?
  height         Int?
  durationMs     Int?
  message        String?

  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@map("media_optimization_logs")
}
