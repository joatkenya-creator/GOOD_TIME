{
  "name": "good-time",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:catalog": "tsx prisma/seed-catalog.ts",
    "db:seed:checkout": "tsx prisma/seed-checkout.ts",
    "db:seed:customers": "tsx --conditions=react-server prisma/seed-customers.ts",
    "db:verify": "node scripts/verify-db.cjs",
    "smoke:catalog": "tsx --conditions=react-server scripts/smoke-catalog.ts",
    "smoke:checkout": "tsx --conditions=react-server scripts/smoke-checkout.ts",
    "verify:orders": "tsx --conditions=react-server scripts/verify-orders.ts",
    "verify:rewards": "tsx --conditions=react-server scripts/verify-rewards.ts",
    "verify:flow": "node scripts/verify-checkout-flow.mjs",
    "verify:confirmation": "node scripts/verify-confirmation.mjs",
    "verify:account": "node scripts/verify-account.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "db:seed:admin": "tsx --conditions=react-server prisma/seed-admin.ts",
    "measure:product": "tsx --conditions=react-server scripts/measure-product-page.ts",
    "verify:gift-cards": "tsx --conditions=react-server scripts/verify-gift-cards.ts",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:admin-crud": "node scripts/verify-admin-crud.mjs",
    "verify:admin-ui": "node scripts/verify-admin-ui.mjs",
    "verify:quality": "node scripts/verify-quality.mjs",
    "grant-admin": "tsx scripts/grant-role.ts",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit:checkout": "node scripts/audit-checkout.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
